{
   "background": {
      "persistent": false,
      "scripts": [ "js/background.js", "/js/update-conf.js", "/js/update.js" ]
   },
   "browser_action": {
      "browser_style": true,
      "default_popup": "popup.html",
      "theme_icons": [ {
         "light": "icon/16.png",
         "size": 16
      }, {
         "light": "icon/32.png",
         "size": 32
      }, {
         "light": "icon/48.png",
         "size": 48
      }, {
         "light": "icon/64.png",
         "size": 64
      } ]
   },
   "container": [ "GOOGLE_DRIVE" ],
   "default_locale": "en",
   "description": "__MSG_application_description__",
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "256": "icon/256.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "512": "icon/512.png"
   },
   "key": "",
   "manifest_version": 2,
   "name": "__MSG_application_title__",
   "offline_enabled": true,
   "options_page": "options.html",
   "permissions": [ "activeTab", "bookmarks", "chrome://favicon/*" ],
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "1.0.1",
   "web_accessible_resources": [ "favicon.ico" ]
}
