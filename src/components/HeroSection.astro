---
import { Image } from 'astro:assets';
import parallaxBackground from '../assets/parallax/background.png';
import parallaxForeground from '../assets/parallax/foreground.png';
import type { GuestInfo } from '../utils/guests';

export interface Props {
  guestInfo: GuestInfo;
  debutanteName?: string;
  debutDate?: string;
  venueName?: string;
}

const {
  guestInfo
} = Astro.props;

const guestNameIsCompact = guestInfo.rawName.length >= 25;
---

<div id="splash-screen" class="splash-overlay">
  <div class="landing-scene">
    <section class="moonlit-letter" id="moonlit-letter" aria-labelledby="landing-title">
      <span class="letter-star letter-star-left" aria-hidden="true">✦</span>
      <span class="letter-star letter-star-right" aria-hidden="true">✦</span>

      <h1 class="guest-greeting font-serif">
        <span>Hi,</span>
        <span class="guest-sparkle-wrapper inline-reveal-wrapper" id="guest-wrapper">
          <span class:list={['guest-name-text', 'font-cursive', 'inline-reveal-text', { 'guest-name-compact': guestNameIsCompact }]} id="guest-name-reveal">{guestInfo.rawName}</span>
          <span class="guest-writing-glow" id="guest-writing-glow" aria-hidden="true"></span>
          <canvas class="sparkle-leading-canvas" id="guest-sparkle-canvas" aria-hidden="true"></canvas>
        </span>
      </h1>

      <div class="letter-rule" aria-hidden="true"><span>✦</span></div>
      <p class="invitation-label font-serif">You are invited to:</p>
      <h2 class="event-title" id="landing-title">
        <span class="event-name font-cursive">Isabel,</span>
        <span class="event-theme font-serif">Once Upon Eighteen</span>
      </h2>

      <button class="btn-gold btn-reveal" id="accept-invitation-btn" data-guest-name={guestInfo.rawName} data-guest-role={guestInfo.role}>
        <span>Accept Invitation & Open</span>
        <span aria-hidden="true">✦</span>
      </button>
    </section>

    <figure class="portrait-stage" id="portrait-stage" aria-label="Portrait of Isabel">
      <Image id="scene-background" class="scene-layer scene-background" src={parallaxBackground} alt="" width={1024} quality={76} format="webp" loading="eager" fetchpriority="high" />
      <canvas id="scene-sparkles" class="scene-layer scene-sparkles" aria-hidden="true"></canvas>
      <Image id="scene-foreground" class="scene-layer scene-foreground" src={parallaxForeground} alt="Isabel in a violet debut gown" width={1024} quality={82} format="webp" loading="eager" fetchpriority="high" />
      <div class="scene-vignette" aria-hidden="true"></div>
    </figure>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import {
    easeHandwritingProgress,
    getMoteSpawnCount,
  } from '../utils/handwriting';
  import { getRenderingBudget } from '../utils/performance';

  const heroAnimationFrames = new Set<number>();
  const heroTimeouts = new Set<number>();
  let backgroundAudio: HTMLAudioElement | null = null;
  let audioFadeInterval: number | null = null;
  let heroDestroyed = false;
  let heroLifecycleGeneration = 0;

  function scheduleHeroFrame(callback: FrameRequestCallback) {
    const id = requestAnimationFrame((time) => {
      heroAnimationFrames.delete(id);
      if (!heroDestroyed) callback(time);
    });
    heroAnimationFrames.add(id);
    return id;
  }

  function scheduleHeroTimeout(callback: () => void, delay: number) {
    const id = window.setTimeout(() => {
      heroTimeouts.delete(id);
      if (!heroDestroyed) callback();
    }, delay);
    heroTimeouts.add(id);
    return id;
  }

  function clearHeroScheduledWork() {
    heroLifecycleGeneration++;
    heroAnimationFrames.forEach((id) => cancelAnimationFrame(id));
    heroAnimationFrames.clear();
    heroTimeouts.forEach((id) => clearTimeout(id));
    heroTimeouts.clear();
    if (audioFadeInterval !== null) clearInterval(audioFadeInterval);
    audioFadeInterval = null;
  }

  function releaseSparkleCanvases() {
    document.querySelectorAll<HTMLCanvasElement>('.sparkle-overlay-canvas, .sparkle-leading-canvas').forEach((canvas) => {
      canvas.style.display = 'none';
      canvas.width = 1;
      canvas.height = 1;
    });
    const glow = document.getElementById('guest-writing-glow');
    if (glow) glow.style.opacity = '0';
  }

  function teardownHeroResources() {
    if (heroDestroyed) return;
    heroDestroyed = true;
    clearHeroScheduledWork();
    if (backgroundAudio) {
      backgroundAudio.pause();
      backgroundAudio.removeAttribute('src');
      backgroundAudio.load();
      backgroundAudio = null;
    }
    confetti.reset();
    releaseSparkleCanvases();
  }

  function handleHeroPageHide(event: PageTransitionEvent) {
    if (!event.persisted) {
      teardownHeroResources();
      return;
    }

    clearHeroScheduledWork();
    backgroundAudio?.pause();
    confetti.reset();
    releaseSparkleCanvases();
    const guestName = document.getElementById('guest-name-reveal');
    if (guestName) {
      guestName.style.width = 'auto';
      guestName.style.opacity = '1';
      guestName.classList.remove('is-revealing');
      guestName.classList.add('is-complete');
    }
  }

  function handleHeroPageShow(event: PageTransitionEvent) {
    if (event.persisted && backgroundAudio) {
      backgroundAudio.play().catch(() => {});
    }
  }

  window.addEventListener('pagehide', handleHeroPageHide);
  window.addEventListener('pageshow', handleHeroPageShow);

  // --- FEATHERED SOFT BLUR EDGE & LEADING SPARKLE REVEAL ENGINE ---
  function initFeatheredHandwritingSparkleReveal() {
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const budget = getRenderingBudget(window.innerWidth, motionQuery.matches);
    const lifecycleGeneration = heroLifecycleGeneration;
    const handwritingFont = '700 1em "Great Vibes"';
    const fontLoadTimeout = 1200;
    const sequences = [
      {
        wrapper: document.getElementById('guest-wrapper'),
        textEl: document.getElementById('guest-name-reveal'),
        glow: document.getElementById('guest-writing-glow'),
        canvas: document.getElementById('guest-sparkle-canvas') as HTMLCanvasElement | null,
        delay: 350,
        duration: 1500
      }
    ];

    sequences.forEach(({ wrapper, textEl, glow, canvas, delay, duration }) => {
      if (!wrapper || !textEl || !glow || !canvas) return;

      const sequenceWrapper = wrapper;
      const sequenceText = textEl;
      const sequenceGlow = glow;
      const sequenceCanvas = canvas;
      const dpr = budget.handwritingCanvasDpr;
      let ctx: CanvasRenderingContext2D | null = null;
      let fullW = 0;
      let finished = false;
      const motes: Mote[] = [];

      interface Mote {
        bornAt: number;
        duration: number;
        originX: number;
        originY: number;
        driftX: number;
        driftY: number;
        size: number;
      }

      function finishSequence() {
        if (finished) return;
        finished = true;
        sequenceWrapper.style.setProperty('--reveal-position', '100%');
        sequenceWrapper.style.setProperty('--reveal-x', `${fullW}px`);
        sequenceText.classList.remove('is-revealing');
        sequenceText.classList.add('is-complete');
        sequenceGlow.style.opacity = '0';
        ctx?.clearRect(0, 0, sequenceCanvas.width / dpr, sequenceCanvas.height / dpr);
        sequenceCanvas.style.display = 'none';
        sequenceCanvas.width = 1;
        sequenceCanvas.height = 1;
        motes.length = 0;
      }

      if (budget.handwritingParticleScale === 0) {
        finishSequence();
        return;
      }

      function startSequence() {
        fullW = Math.ceil(sequenceText.getBoundingClientRect().width || sequenceText.scrollWidth);
        const fullH = Math.ceil(sequenceText.getBoundingClientRect().height || sequenceText.scrollHeight);

        if (fullW <= 0 || fullH <= 0) {
          finishSequence();
          return;
        }

        ctx = sequenceCanvas.getContext('2d');
        if (!ctx) {
          finishSequence();
          return;
        }

        const padX = 30;
        const padY = 20;
        sequenceCanvas.width = Math.ceil((fullW + padX * 2) * dpr);
        sequenceCanvas.height = Math.ceil((fullH + padY * 2) * dpr);
        sequenceCanvas.style.width = `${fullW + padX * 2}px`;
        sequenceCanvas.style.height = `${fullH + padY * 2}px`;
        sequenceCanvas.style.left = `-${padX}px`;
        sequenceCanvas.style.top = `-${padY}px`;
        sequenceCanvas.style.display = 'block';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const colors = ['#FFF6D5', '#F6E597', '#D4AF37', '#FFFFFF', '#EECE5A'];
        const motePattern = [
          { offsetX: -3, offsetY: -6, driftX: -7, driftY: -13, size: 2.8, duration: 420 },
          { offsetX: 2, offsetY: 5, driftX: 8, driftY: 11, size: 2.2, duration: 360 },
          { offsetX: 5, offsetY: -1, driftX: 11, driftY: -7, size: 2.5, duration: 480 },
          { offsetX: -1, offsetY: 8, driftX: -4, driftY: 14, size: 2, duration: 400 },
        ];
        const centerY = padY + fullH * 0.52;
        let nextMotePattern = 0;
        let lastEmissionX = 0;

        function drawDiamondStar(x: number, y: number, r: number, rot: number, color: string, alpha: number) {
          if (!ctx) return;
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(rot);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.fillStyle = color;

          ctx.beginPath();
          for (let i = 0; i < 4; i++) {
            ctx.lineTo(Math.cos((i * Math.PI) / 2) * r, Math.sin((i * Math.PI) / 2) * r);
            ctx.lineTo(
              Math.cos((i * Math.PI) / 2 + Math.PI / 4) * (r * 0.22),
              Math.sin((i * Math.PI) / 2 + Math.PI / 4) * (r * 0.22)
            );
          }
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        sequenceText.classList.add('is-revealing');
        const startTime = performance.now();

        function renderFrame(now: number) {
          if (finished || !ctx) return;

          ctx.clearRect(0, 0, sequenceCanvas.width / dpr, sequenceCanvas.height / dpr);

          const rawProgress = Math.min(1, Math.max(0, (now - startTime) / duration));
          const progress = easeHandwritingProgress(rawProgress);
          const edgeX = fullW * progress;

          sequenceWrapper.style.setProperty('--reveal-position', `${progress * 100}%`);
          sequenceWrapper.style.setProperty('--reveal-x', `${edgeX}px`);
          sequenceGlow.style.opacity = String(Math.sin(Math.PI * rawProgress) * 0.9);

          if (rawProgress < 1) {
            drawDiamondStar(edgeX + padX, centerY, 5.5, Math.PI / 4, '#FFF6D5', 0.95);

            const spawnCount = getMoteSpawnCount(
              edgeX - lastEmissionX,
              budget.profile === 'mobile' ? 22 : 14,
              motes.length,
              budget.handwritingMoteLimit,
            );

            if (spawnCount > 0) {
              for (let i = 0; i < spawnCount; i++) {
                const pattern = motePattern[nextMotePattern % motePattern.length];
                nextMotePattern++;
                motes.push({
                  bornAt: now,
                  duration: pattern.duration,
                  originX: edgeX + padX + pattern.offsetX,
                  originY: centerY + pattern.offsetY,
                  driftX: pattern.driftX,
                  driftY: pattern.driftY,
                  size: pattern.size,
                });
              }
              lastEmissionX = edgeX;
            }
          }

          for (let i = motes.length - 1; i >= 0; i--) {
            const mote = motes[i];
            const age = now - mote.bornAt;
            if (age >= mote.duration) {
              motes.splice(i, 1);
              continue;
            }

            const moteProgress = Math.max(0, age / mote.duration);
            const alpha = Math.sin(Math.PI * moteProgress) * 0.85;
            drawDiamondStar(
              mote.originX + mote.driftX * moteProgress,
              mote.originY + mote.driftY * moteProgress,
              mote.size * Math.sin(Math.PI * moteProgress),
              Math.PI / 4 + moteProgress * 0.35,
              colors[i % colors.length],
              alpha,
            );
          }

          if (rawProgress < 1 || motes.length > 0) {
            scheduleHeroFrame(renderFrame);
          } else {
            finishSequence();
          }
        }

        scheduleHeroFrame(renderFrame);
      }

      function startWhenFontReady() {
        const sampleText = sequenceText.textContent?.trim() || 'Guest';
        let fontWaitFinished = false;

        function settleFontWait(fontLoaded: boolean) {
          if (fontWaitFinished) return;
          fontWaitFinished = true;

          if (
            heroDestroyed ||
            finished ||
            lifecycleGeneration !== heroLifecycleGeneration
          ) {
            return;
          }

          if (fontLoaded) {
            startSequence();
          } else {
            finishSequence();
          }
        }

        scheduleHeroTimeout(() => settleFontWait(false), fontLoadTimeout);
        document.fonts.load(handwritingFont, sampleText).then(
          (fontFaces) => settleFontWait(fontFaces.length > 0),
          () => settleFontWait(false),
        );
      }

      scheduleHeroTimeout(startWhenFontReady, delay);
    });
  }

  const GOOGLE_SHEETS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwwPB4mXKlNyNUIKocRuNXLbReyl71p00_-rFNv2oQ1s9lh4kXwjTIYTJ09H37nJ_U6/exec";

  function startBackgroundAudio() {
    if (backgroundAudio) return;
    backgroundAudio = new Audio('/audio/bgm.mp3');
    backgroundAudio.loop = true;
    backgroundAudio.volume = 0;

    backgroundAudio.play().then(() => {
      let volume = 0;
      audioFadeInterval = window.setInterval(() => {
        if (!backgroundAudio) return;
        volume += 0.03;
        if (volume >= 0.35) {
          backgroundAudio.volume = 0.35;
          if (audioFadeInterval !== null) clearInterval(audioFadeInterval);
          audioFadeInterval = null;
        } else {
          backgroundAudio.volume = volume;
        }
      }, 80);
    }).catch((err) => {
      console.log('Audio playback initialized:', err);
      backgroundAudio = null;
    });
  }

  function initOpeningTransition() {
    const btn = document.getElementById('accept-invitation-btn');
    const splash = document.getElementById('splash-screen');
    const mainContent = document.getElementById('main-revealed-content');

    if (!btn || !splash) return;

    btn.addEventListener('click', () => {
      // 0. Log Splash Invitation Acceptance to Google Sheets
      const guestName = btn.getAttribute('data-guest-name') || 'Honored Guest';
      const guestRole = btn.getAttribute('data-guest-role') || 'Honored Guest';

      if (GOOGLE_SHEETS_SCRIPT_URL) {
        try {
          fetch(GOOGLE_SHEETS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              guestName: guestName,
              role: guestRole,
              action: 'accept_splash',
              attendance: 'Opened Splash (Accepted)',
              timestamp: new Date().toISOString()
            })
          }).catch(err => console.warn('Splash tracking note:', err));
        } catch(e) {}
      }

      // 1. Play processed background music continuously in a loop upon accepting invitation
      try {
        startBackgroundAudio();
      } catch(e) {}

      // 2. Confetti explosion (scaled for mobile performance)
      const budget = getRenderingBudget(
        window.innerWidth,
        window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      );
      if (budget.confettiParticles > 0) {
        confetti({
          particleCount: budget.confettiParticles,
          spread: budget.profile === 'mobile' ? 75 : 100,
          origin: { y: 0.5 },
          colors: ['#D4AF37', '#F6E597', '#0B132B', '#FFFFFF', '#EECE5A']
        });
      }

      // 3. Splash curtain transition
      splash.classList.add('opening-transition');

      if (mainContent) {
        mainContent.classList.remove('hidden-main');
        mainContent.classList.add('revealed-active');
      }

      window.scrollTo(0, 0);
      document.body.classList.remove('splash-locked');

      scheduleHeroTimeout(() => {
        splash.classList.add('splash-dismissed');
        splash.style.display = 'none';
      }, 1100);
    }, { once: true });
  }

  function onReady(fn: () => void) {
    if (document.readyState !== 'loading') {
      fn();
    } else {
      document.addEventListener('DOMContentLoaded', fn);
    }
  }

  onReady(() => {
    initFeatheredHandwritingSparkleReveal();
    initOpeningTransition();
  });
</script>

<style>
  /* Inline Handwriting Reveal with Soft Feathered Edge Masking */
  .inline-reveal-wrapper {
    --reveal-position: 0%;
    --reveal-x: 0px;
    position: relative;
    display: inline-flex;
    align-items: baseline;
    vertical-align: baseline;
    isolation: isolate;
  }

  .inline-reveal-text {
    display: inline-block;
    vertical-align: baseline;
    white-space: nowrap;
    opacity: 1;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(var(--reveal-position) - 18px),
      rgba(0, 0, 0, 0.75) calc(var(--reveal-position) - 8px),
      transparent var(--reveal-position),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(var(--reveal-position) - 18px),
      rgba(0, 0, 0, 0.75) calc(var(--reveal-position) - 8px),
      transparent var(--reveal-position),
      transparent 100%
    );
  }

  .inline-reveal-text.is-revealing {
    opacity: 1;
  }

  .inline-reveal-text.is-complete {
    width: auto !important;
    overflow: visible !important;
    opacity: 1 !important;
    -webkit-mask-image: none !important;
    mask-image: none !important;
    filter: none !important;
    -webkit-filter: none !important;
  }

  .guest-writing-glow {
    position: absolute;
    left: 0;
    top: 52%;
    width: 58px;
    height: 42px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--reveal-x), -50%, 0) translateX(-50%);
    background: radial-gradient(ellipse, rgba(255, 239, 166, 0.42) 0%, rgba(224, 174, 55, 0.16) 42%, transparent 74%);
  }

  .sparkle-leading-canvas {
    position: absolute;
    pointer-events: none;
    z-index: 10;
  }

  /* Moonlit letter and shared portrait geometry */
  .splash-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
    background: #050914;
    padding: max(10px, env(safe-area-inset-top)) 10px max(10px, env(safe-area-inset-bottom));
    transition: opacity 320ms ease;
  }

  .splash-overlay.opening-transition {
    opacity: 0;
    pointer-events: none;
  }

  .splash-overlay.splash-dismissed {
    display: none !important;
  }

  .landing-scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    width: min(1180px, 100%);
    height: 100%;
    margin: 0 auto;
    isolation: isolate;
  }

  .portrait-stage {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #10170d;
  }

  .scene-layer {
    position: absolute;
    inset: -14px;
    width: calc(100% + 28px);
    height: calc(100% + 28px);
    object-fit: cover;
    object-position: center center;
    transform: translate3d(var(--scene-x, 0), var(--scene-y, 0), 0);
  }

  .scene-background { z-index: 0; }
  .scene-sparkles { z-index: 1; pointer-events: none; }
  .scene-foreground { z-index: 2; }

  .scene-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 9, 20, 0.14), transparent 22%, transparent 72%, rgba(5, 9, 20, 0.54)),
      linear-gradient(0deg, rgba(5, 9, 20, 0.34), transparent 24%, rgba(5, 9, 20, 0.12));
  }

  .moonlit-letter {
    position: relative;
    z-index: 5;
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    margin-left: clamp(-42px, -3vw, -18px);
    padding: 40px 34px 34px;
    border: 1px solid rgba(224, 188, 75, 0.72);
    border-radius: 4px;
    color: #fff8dc;
    text-align: center;
    background-color: rgba(7, 13, 31, 0.92);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.42), inset 0 0 32px rgba(218, 180, 74, 0.07);
  }

  .moonlit-letter::before,
  .moonlit-letter::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .moonlit-letter::before {
    inset: 7px;
    z-index: -1;
    border: 1px solid rgba(244, 214, 126, 0.34);
    border-radius: 2px;
  }

  .moonlit-letter::after {
    inset: 0;
    z-index: -2;
    opacity: 0.22;
    background-image:
      radial-gradient(circle at 18% 27%, rgba(255, 255, 255, 0.2) 0 0.6px, transparent 0.8px),
      radial-gradient(circle at 73% 62%, rgba(228, 199, 121, 0.18) 0 0.5px, transparent 0.8px),
      radial-gradient(circle at 42% 84%, rgba(255, 255, 255, 0.13) 0 0.5px, transparent 0.75px);
    background-size: 13px 17px, 19px 23px, 29px 31px;
  }

  .letter-star {
    position: absolute;
    top: 17px;
    color: #e5c760;
    font-size: 0.8rem;
    line-height: 1;
  }

  .letter-star-left { left: 19px; }
  .letter-star-right { right: 19px; }

  .guest-greeting {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    margin: 0;
    color: #fff8dc;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .guest-sparkle-wrapper {
    justify-content: center;
    max-width: 100%;
  }

  .guest-name-text {
    max-width: 100%;
    color: #f5d979;
    font-size: 1.18em;
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }

  .guest-name-compact {
    font-size: 1.65rem;
  }

  .guest-name-text.is-complete {
    color: #f5d979;
  }

  .letter-rule {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(250px, 80%);
    margin: 16px auto 13px;
    color: #d9b84f;
    font-size: 0.62rem;
  }

  .letter-rule::before,
  .letter-rule::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(224, 188, 75, 0.78));
  }

  .letter-rule::after {
    transform: rotate(180deg);
  }

  .invitation-label {
    margin: 0 0 7px;
    color: rgba(255, 248, 220, 0.78);
    font-size: 0.82rem;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .event-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    color: #fff8dc;
  }

  .event-name {
    color: #f3d46c;
    font-size: 3.55rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-theme {
    margin-top: 4px;
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .btn-reveal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 46px;
    margin-top: 24px;
    animation: pulseGlow 3s ease-in-out infinite;
  }

  @media (max-width: 899px) {
