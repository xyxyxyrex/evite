---
import { Image } from 'astro:assets';
import parallaxBackground from '../assets/parallax/background.png';
import parallaxForeground from '../assets/parallax/foreground.png';
import type { GuestInfo } from '../utils/guests';

export interface Props {
  guestInfo: GuestInfo;
  debutanteName?: string;
  debutDate?: string;
  venueName?: string;
}

const {
  guestInfo
} = Astro.props;

const guestNameIsCompact = guestInfo.rawName.length >= 25;
---

<div id="splash-screen" class="splash-overlay">
  <div class="landing-scene">
    <section class="moonlit-letter" id="moonlit-letter" aria-labelledby="landing-title">
      <span class="letter-border-trace" aria-hidden="true"></span>
      <span class="letter-star letter-star-left" aria-hidden="true">✦</span>
      <span class="letter-star letter-star-right" aria-hidden="true">✦</span>

      <h1 class="guest-greeting font-serif">
        <span>Hi,</span>
        <span class="guest-sparkle-wrapper inline-reveal-wrapper" id="guest-wrapper">
          <span class:list={['guest-name-text', 'font-cursive', 'inline-reveal-text', { 'guest-name-compact': guestNameIsCompact }]} id="guest-name-reveal">{guestInfo.rawName}</span>
          <span class="guest-writing-glow" id="guest-writing-glow" aria-hidden="true"></span>
          <canvas class="sparkle-leading-canvas" id="guest-sparkle-canvas" aria-hidden="true"></canvas>
        </span>
      </h1>

      <div class="letter-rule" aria-hidden="true"><span>✦</span></div>
      <p class="invitation-label font-serif">You are invited to:</p>
      <h2 class="event-title" id="landing-title">
        <span class="event-name font-cursive">Isabel,</span>
        <span class="event-theme font-serif">Once Upon Eighteen</span>
      </h2>

      <button class="btn-gold btn-reveal" id="accept-invitation-btn" data-guest-name={guestInfo.rawName} data-guest-role={guestInfo.role}>
        <span>Accept Invitation & Open</span>
        <span aria-hidden="true">✦</span>
      </button>
    </section>

    <div class="unseal-motes" aria-hidden="true">
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
      <span class="unseal-mote" aria-hidden="true"></span>
    </div>

    <figure class="portrait-stage" id="portrait-stage" aria-label="Portrait of Isabel">
      <Image id="scene-background" class="scene-layer scene-background" src={parallaxBackground} alt="" width={1024} quality={76} format="webp" loading="eager" fetchpriority="high" />
      <canvas id="scene-magic-rear" class="scene-layer scene-magic scene-magic-rear" aria-hidden="true"></canvas>
      <Image id="scene-foreground" class="scene-layer scene-foreground" src={parallaxForeground} alt="Isabel in a violet debut gown" width={1024} quality={82} format="webp" loading="eager" fetchpriority="high" />
      <canvas id="scene-magic-front" class="scene-layer scene-magic scene-magic-front" aria-hidden="true"></canvas>
      <div class="scene-vignette" aria-hidden="true"></div>
    </figure>
  </div>
  <div class="opening-veil" id="opening-veil" aria-hidden="true"></div>
</div>

<script>
  import {
    easeHandwritingProgress,
    getMoteSpawnCount,
  } from '../utils/handwriting';
  import {
    getMagicTrailPoint,
    normalizeOrientation,
    normalizeScenePointer,
    sampleMagicTrail,
  } from '../utils/landingScene';
  import { getRenderingBudget } from '../utils/performance';

  interface SceneSparkle {
    progress: number;
    x: number;
    y: number;
    radius: number;
    phase: number;
    speed: number;
  }

  const heroAnimationFrames = new Set<number>();
  const heroTimeouts = new Set<number>();
  let backgroundAudio: HTMLAudioElement | null = null;
  let audioFadeInterval: number | null = null;
  let openingFinalizer: (() => void) | null = null;
  let heroDestroyed = false;
  let heroLifecycleGeneration = 0;
  let sceneInputFrame = 0;
  let sceneSparkleFrame = 0;
  let sceneDestroyed = false;
  let sceneVisible = !document.hidden;
  let sceneSparkles: SceneSparkle[] = [];
  let sceneInitialized = false;
  let sceneStage: HTMLElement | null = null;
  let sceneBackground: HTMLElement | null = null;
  let sceneCanvas: HTMLCanvasElement | null = null;
  let sceneFrontCanvas: HTMLCanvasElement | null = null;
  let sceneForeground: HTMLElement | null = null;
  let sceneContext: CanvasRenderingContext2D | null = null;
  let sceneFrontContext: CanvasRenderingContext2D | null = null;
  let sceneRearPath: Path2D | null = null;
  let sceneFrontPath: Path2D | null = null;
  let sceneGlowSprite: HTMLCanvasElement | null = null;
  let sceneCanvasDpr = 1;
  let sceneCanvasWidth = 0;
  let sceneCanvasHeight = 0;
  let sceneFrameInterval = 0;
  let sceneLastRenderTime = -Infinity;
  let sceneReducedMotion = false;
  const sceneTrailPointCount = 192;
  const sceneTrailX = new Float32Array(sceneTrailPointCount);
  const sceneTrailY = new Float32Array(sceneTrailPointCount);
  const sceneTrailSampleA = { x: 0, y: 0 };
  const sceneTrailSampleB = { x: 0, y: 0 };
  let sceneClientX = 0;
  let sceneClientY = 0;
  let sceneInputX = 0;
  let sceneInputY = 0;
  let sceneTargetX = 0;
  let sceneTargetY = 0;
  let sceneUsingOrientation = false;
  let sceneOrientationEnabled = false;
  let sceneOrientationListening = false;
  let sceneOrientationPermissionPending = false;
  let sceneOrientationBaselineBeta: number | null = null;
  let sceneOrientationBaselineGamma: number | null = null;
  let scenePointerResetPending = true;

  type OrientationEventConstructor = typeof DeviceOrientationEvent & {
    requestPermission?: () => Promise<'granted' | 'denied'>;
  };

  function scheduleHeroFrame(callback: FrameRequestCallback) {
    const id = requestAnimationFrame((time) => {
      heroAnimationFrames.delete(id);
      if (!heroDestroyed) callback(time);
    });
    heroAnimationFrames.add(id);
    return id;
  }

  function scheduleHeroTimeout(callback: () => void, delay: number) {
    const id = window.setTimeout(() => {
      heroTimeouts.delete(id);
      if (!heroDestroyed) callback();
    }, delay);
    heroTimeouts.add(id);
    return id;
  }

  function clearHeroScheduledWork() {
    heroLifecycleGeneration++;
    heroAnimationFrames.forEach((id) => cancelAnimationFrame(id));
    heroAnimationFrames.clear();
    heroTimeouts.forEach((id) => clearTimeout(id));
    heroTimeouts.clear();
    if (audioFadeInterval !== null) clearInterval(audioFadeInterval);
    audioFadeInterval = null;
  }

  function finalizeOpeningTransition() {
    const finalize = openingFinalizer;
    if (!finalize) return;
    openingFinalizer = null;
    finalize();
  }

  function releaseSparkleCanvases() {
    document.querySelectorAll<HTMLCanvasElement>('.sparkle-overlay-canvas, .sparkle-leading-canvas').forEach((canvas) => {
      canvas.style.display = 'none';
      canvas.width = 1;
      canvas.height = 1;
    });
    const glow = document.getElementById('guest-writing-glow');
    if (glow) glow.style.opacity = '0';
  }

  function resetSceneLayers() {
    sceneBackground?.style.setProperty('--scene-x', '0px');
    sceneBackground?.style.setProperty('--scene-y', '0px');
    sceneCanvas?.style.setProperty('--scene-x', '0px');
    sceneCanvas?.style.setProperty('--scene-y', '0px');
    sceneFrontCanvas?.style.setProperty('--scene-x', '0px');
    sceneFrontCanvas?.style.setProperty('--scene-y', '0px');
    sceneForeground?.style.setProperty('--scene-x', '0px');
    sceneForeground?.style.setProperty('--scene-y', '0px');
  }

  function applyScenePointerFrame() {
    sceneInputFrame = 0;
    if (
      sceneDestroyed ||
      !sceneVisible ||
      !sceneStage ||
      !sceneBackground ||
      !sceneCanvas ||
      !sceneFrontCanvas ||
      !sceneForeground
    ) {
      return;
    }

    if (scenePointerResetPending) {
      sceneInputX = 0;
      sceneInputY = 0;
      sceneTargetX = 0;
      sceneTargetY = 0;
      resetSceneLayers();
      return;
    }

    const smoothing = sceneUsingOrientation ? 0.16 : 1;
    sceneInputX += (sceneTargetX - sceneInputX) * smoothing;
    sceneInputY += (sceneTargetY - sceneInputY) * smoothing;
    sceneBackground.style.setProperty('--scene-x', `${sceneInputX * 4}px`);
    sceneBackground.style.setProperty('--scene-y', `${sceneInputY * 4}px`);
    sceneCanvas.style.setProperty('--scene-x', `${sceneInputX * 8}px`);
    sceneCanvas.style.setProperty('--scene-y', `${sceneInputY * 8}px`);
    sceneFrontCanvas.style.setProperty('--scene-x', `${sceneInputX * 8}px`);
    sceneFrontCanvas.style.setProperty('--scene-y', `${sceneInputY * 8}px`);
    sceneForeground.style.setProperty('--scene-x', `${sceneInputX * 12}px`);
    sceneForeground.style.setProperty('--scene-y', `${sceneInputY * 12}px`);

    if (
      sceneUsingOrientation &&
      (Math.abs(sceneTargetX - sceneInputX) > 0.002 || Math.abs(sceneTargetY - sceneInputY) > 0.002)
    ) {
      scheduleSceneInputFrame();
    }
  }

  function scheduleSceneInputFrame() {
    if (sceneDestroyed || !sceneVisible || sceneInputFrame) return;
    sceneInputFrame = requestAnimationFrame(applyScenePointerFrame);
  }

  function handleScenePointer(event: PointerEvent) {
    if (sceneUsingOrientation || !sceneStage) return;
    sceneClientX = event.clientX;
    sceneClientY = event.clientY;
    const rect = sceneStage.getBoundingClientRect();
    const pointer = normalizeScenePointer(
      sceneClientX,
      sceneClientY,
      rect.left,
      rect.top,
      rect.width,
      rect.height,
    );
    sceneTargetX = pointer.x;
    sceneTargetY = pointer.y;
    scenePointerResetPending = false;
    scheduleSceneInputFrame();
  }

  function resetScenePointer() {
    if (sceneUsingOrientation) return;
    scenePointerResetPending = true;
    scheduleSceneInputFrame();
  }

  function resizeSceneCanvas() {
    if (
      sceneDestroyed ||
      !sceneStage ||
      !sceneCanvas ||
      !sceneFrontCanvas ||
      !sceneContext ||
      !sceneFrontContext
    ) return;

    const rect = sceneStage.getBoundingClientRect();
    sceneCanvasWidth = Math.max(0, rect.width);
    sceneCanvasHeight = Math.max(0, rect.height);
    const backingWidth = Math.max(1, Math.ceil(sceneCanvasWidth * sceneCanvasDpr));
    const backingHeight = Math.max(1, Math.ceil(sceneCanvasHeight * sceneCanvasDpr));

    if (sceneCanvas.width !== backingWidth || sceneCanvas.height !== backingHeight) {
      sceneCanvas.width = backingWidth;
      sceneCanvas.height = backingHeight;
      sceneContext.setTransform(sceneCanvasDpr, 0, 0, sceneCanvasDpr, 0, 0);
    }
    if (sceneFrontCanvas.width !== backingWidth || sceneFrontCanvas.height !== backingHeight) {
      sceneFrontCanvas.width = backingWidth;
      sceneFrontCanvas.height = backingHeight;
      sceneFrontContext.setTransform(sceneCanvasDpr, 0, 0, sceneCanvasDpr, 0, 0);
    }

    buildScenePaths();
    if (sceneReducedMotion) drawSceneMagic(0, false);
  }

  function getFrontOrbitVisibility(progress: number) {
    const wrapped = ((progress % 1) + 1) % 1;
    const start = 0.44;
    const end = 0.84;
    const fade = 0.035;
    if (wrapped <= start - fade || wrapped >= end + fade) return 0;
    if (wrapped >= start + fade && wrapped <= end - fade) return 1;
    const edge = wrapped < start + fade
      ? (wrapped - (start - fade)) / (fade * 2)
      : ((end + fade) - wrapped) / (fade * 2);
    return edge * edge * (3 - 2 * edge);
  }

  function buildScenePaths() {
    sceneRearPath = new Path2D();
    sceneFrontPath = new Path2D();
    for (let i = 0; i < sceneTrailPointCount; i++) {
      const next = (i + 1) % sceneTrailPointCount;
      const progress = (i + 0.5) / sceneTrailPointCount;
      const path = getFrontOrbitVisibility(progress) >= 0.5 ? sceneFrontPath : sceneRearPath;
      path.moveTo(sceneTrailX[i] * sceneCanvasWidth, sceneTrailY[i] * sceneCanvasHeight);
      path.lineTo(sceneTrailX[next] * sceneCanvasWidth, sceneTrailY[next] * sceneCanvasHeight);
    }
  }

  function createSceneGlowSprite() {
    const sprite = document.createElement('canvas');
    sprite.width = 96;
    sprite.height = 96;
    const context = sprite.getContext('2d');
    if (!context) return null;
    const gradient = context.createRadialGradient(48, 48, 1, 48, 48, 48);
    gradient.addColorStop(0, 'rgba(255, 250, 218, 0.98)');
    gradient.addColorStop(0.12, 'rgba(255, 224, 128, 0.72)');
    gradient.addColorStop(0.42, 'rgba(239, 177, 45, 0.22)');
    gradient.addColorStop(1, 'rgba(239, 177, 45, 0)');
    context.fillStyle = gradient;
    context.fillRect(0, 0, 96, 96);
    return sprite;
  }

  function drawOrbitTail(
    context: CanvasRenderingContext2D,
    headProgress: number,
    frontLayer: boolean,
  ) {
    const tailSteps = 28;
    for (let i = tailSteps; i > 0; i--) {
      const fromProgress = headProgress - i * 0.0036;
      const toProgress = headProgress - (i - 1) * 0.0036;
      const frontVisibility = getFrontOrbitVisibility((fromProgress + toProgress) * 0.5);
      const layerVisibility = frontLayer ? frontVisibility : 1 - frontVisibility;
      if (layerVisibility < 0.015) continue;
      sampleMagicTrail(fromProgress, sceneTrailX, sceneTrailY, sceneTrailSampleA);
      sampleMagicTrail(toProgress, sceneTrailX, sceneTrailY, sceneTrailSampleB);
      const strength = (tailSteps - i + 1) / tailSteps;
      context.globalAlpha = layerVisibility * (0.06 + strength * 0.84);
      context.lineWidth = 0.8 + strength * 1.9;
      context.strokeStyle = strength > 0.72 ? '#fff3bd' : '#e9b936';
      context.beginPath();
      context.moveTo(sceneTrailSampleA.x * sceneCanvasWidth, sceneTrailSampleA.y * sceneCanvasHeight);
      context.lineTo(sceneTrailSampleB.x * sceneCanvasWidth, sceneTrailSampleB.y * sceneCanvasHeight);
      context.stroke();
    }
  }

  function drawOrbitHead(
    context: CanvasRenderingContext2D,
    headProgress: number,
    frontLayer: boolean,
  ) {
    sampleMagicTrail(headProgress, sceneTrailX, sceneTrailY, sceneTrailSampleA);
    const x = sceneTrailSampleA.x * sceneCanvasWidth;
    const y = sceneTrailSampleA.y * sceneCanvasHeight;
    const frontVisibility = getFrontOrbitVisibility(headProgress);
    const layerVisibility = frontLayer ? frontVisibility : 1 - frontVisibility;

    if (frontLayer && sceneGlowSprite && frontVisibility > 0.01) {
      const glowSize = Math.min(124, Math.max(78, Math.min(sceneCanvasWidth, sceneCanvasHeight) * 0.18));
      context.save();
      context.globalCompositeOperation = 'screen';
      context.globalAlpha = 0.16 + frontVisibility * 0.42;
      context.drawImage(sceneGlowSprite, x - glowSize / 2, y - glowSize / 2, glowSize, glowSize);
      context.restore();
    }

    if (layerVisibility < 0.01) return;
    context.globalAlpha = layerVisibility;
    context.fillStyle = '#fff9df';
    context.shadowColor = '#ffd665';
    context.shadowBlur = 12;
    context.beginPath();
    context.arc(x, y, 2.35, 0, Math.PI * 2);
    context.fill();
  }

  function drawSceneSparkles(
    context: CanvasRenderingContext2D,
    now: number,
    frontLayer: boolean,
  ) {
    context.fillStyle = '#ffe8a3';
    for (let i = 0; i < sceneSparkles.length; i++) {
      const sparkle = sceneSparkles[i];
      const frontVisibility = getFrontOrbitVisibility(sparkle.progress);
      const layerVisibility = frontLayer ? frontVisibility : 1 - frontVisibility;
      if (layerVisibility < 0.015) continue;
      const pulse = (Math.sin(now * sparkle.speed + sparkle.phase) + 1) * 0.5;
      const opacity = (0.24 + pulse * 0.64) * layerVisibility;
      const radius = sparkle.radius * (0.72 + pulse * 0.58);
      const x = sparkle.x * sceneCanvasWidth;
      const y = sparkle.y * sceneCanvasHeight;

      context.globalAlpha = opacity;
      context.beginPath();
      if (i % 4 === 0) {
        context.moveTo(x, y - radius * 2.1);
        context.lineTo(x + radius * 0.34, y - radius * 0.34);
        context.lineTo(x + radius * 2.1, y);
        context.lineTo(x + radius * 0.34, y + radius * 0.34);
        context.lineTo(x, y + radius * 2.1);
        context.lineTo(x - radius * 0.34, y + radius * 0.34);
        context.lineTo(x - radius * 2.1, y);
        context.lineTo(x - radius * 0.34, y - radius * 0.34);
        context.closePath();
      } else {
        context.arc(x, y, radius, 0, Math.PI * 2);
      }
      context.fill();
    }
  }

  function drawSceneMagic(now: number, animated: boolean) {
    if (!sceneContext || !sceneFrontContext || !sceneRearPath || !sceneFrontPath) return;
    sceneContext.clearRect(0, 0, sceneCanvasWidth, sceneCanvasHeight);
    sceneFrontContext.clearRect(0, 0, sceneCanvasWidth, sceneCanvasHeight);

    drawMagicLayer(sceneContext, sceneRearPath, now, animated, false);
    drawMagicLayer(sceneFrontContext, sceneFrontPath, now, animated, true);
  }

  function drawMagicLayer(
    context: CanvasRenderingContext2D,
    path: Path2D,
    now: number,
    animated: boolean,
    frontLayer: boolean,
  ) {
    context.save();
    context.lineCap = 'round';
    context.lineJoin = 'round';
    context.strokeStyle = '#e8bd55';
    context.globalAlpha = animated ? 0.2 : 0.3;
    context.lineWidth = 1.1;
    context.stroke(path);
    if (animated) {
      const headProgress = (now * 0.000045) % 1;
      drawOrbitTail(context, headProgress, frontLayer);
      drawSceneSparkles(context, now, frontLayer);
      drawOrbitHead(context, headProgress, frontLayer);
    }
    context.restore();
  }

  function scheduleSceneSparkleFrame() {
    if (
      sceneDestroyed ||
      !sceneVisible ||
      sceneSparkleFrame ||
      sceneSparkles.length === 0 ||
      !sceneContext ||
      !sceneFrontContext
    ) {
      return;
    }
    sceneSparkleFrame = requestAnimationFrame(renderSceneSparkles);
  }

  function renderSceneSparkles(now: number) {
    sceneSparkleFrame = 0;
    if (
      sceneDestroyed ||
      !sceneVisible ||
      !sceneCanvas ||
      !sceneFrontCanvas ||
      !sceneContext ||
      !sceneFrontContext
    ) return;

    if (now - sceneLastRenderTime >= sceneFrameInterval) {
      sceneLastRenderTime = now;
      drawSceneMagic(now, true);
    }

    scheduleSceneSparkleFrame();
  }

  function pauseLandingScene(resetLayers = false) {
    if (sceneInputFrame) cancelAnimationFrame(sceneInputFrame);
    if (sceneSparkleFrame) cancelAnimationFrame(sceneSparkleFrame);
    sceneInputFrame = 0;
    sceneSparkleFrame = 0;
    if (resetLayers) {
      scenePointerResetPending = true;
      resetSceneLayers();
    }
  }

  function handleSceneOrientation(event: DeviceOrientationEvent) {
    if (!sceneVisible || event.beta === null || event.gamma === null) return;
    if (sceneOrientationBaselineBeta === null || sceneOrientationBaselineGamma === null) {
      sceneOrientationBaselineBeta = event.beta;
      sceneOrientationBaselineGamma = event.gamma;
      return;
    }

    const pointer = normalizeOrientation(
      event.beta - sceneOrientationBaselineBeta,
      event.gamma - sceneOrientationBaselineGamma,
    );
    sceneUsingOrientation = true;
    scenePointerResetPending = false;
    sceneTargetX = pointer.x;
    sceneTargetY = pointer.y;
    scheduleSceneInputFrame();
  }

  function attachSceneOrientation() {
    if (!sceneOrientationEnabled || sceneOrientationListening || !sceneVisible) return;
    window.addEventListener('deviceorientation', handleSceneOrientation, { passive: true });
    sceneOrientationListening = true;
  }

  function detachSceneOrientation() {
    if (!sceneOrientationListening) return;
    window.removeEventListener('deviceorientation', handleSceneOrientation);
    sceneOrientationListening = false;
  }

  async function requestSceneOrientationPermission() {
    if (sceneOrientationPermissionPending || sceneDestroyed) return;
    sceneOrientationPermissionPending = true;
    const constructor = window.DeviceOrientationEvent as OrientationEventConstructor | undefined;
    try {
      if (await constructor?.requestPermission?.() === 'granted') {
        sceneOrientationEnabled = true;
        attachSceneOrientation();
      }
    } catch {
      // Motion access is optional; pointer parallax remains available.
    }
  }

  function initSceneOrientation() {
    if (!window.matchMedia('(pointer: coarse)').matches || !('DeviceOrientationEvent' in window)) return;
    const constructor = window.DeviceOrientationEvent as OrientationEventConstructor;
    if (typeof constructor.requestPermission === 'function') {
      sceneStage?.addEventListener('pointerup', requestSceneOrientationPermission, { once: true });
      return;
    }
    sceneOrientationEnabled = true;
    attachSceneOrientation();
  }

  function handleSceneVisibility() {
    sceneVisible = !document.hidden;
    if (!sceneVisible) {
      detachSceneOrientation();
      pauseLandingScene();
      return;
    }
    attachSceneOrientation();
    scheduleSceneSparkleFrame();
  }

  function initLandingScene() {
    if (sceneInitialized || sceneDestroyed) return;
    sceneInitialized = true;
    sceneStage = document.getElementById('portrait-stage');
    sceneBackground = document.getElementById('scene-background');
    sceneCanvas = document.getElementById('scene-magic-rear') as HTMLCanvasElement | null;
    sceneFrontCanvas = document.getElementById('scene-magic-front') as HTMLCanvasElement | null;
    sceneForeground = document.getElementById('scene-foreground');

    if (!sceneStage || !sceneBackground || !sceneCanvas || !sceneFrontCanvas || !sceneForeground) return;

    const budget = getRenderingBudget(
      window.innerWidth,
      window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    );

    sceneReducedMotion = budget.profile === 'reduced';
    sceneCanvasDpr = sceneReducedMotion ? 1 : budget.sceneCanvasDpr;
    sceneFrameInterval = sceneReducedMotion ? 0 : 1000 / budget.sceneSparkleFps;
    for (let i = 0; i < sceneTrailPointCount; i++) {
      const point = getMagicTrailPoint(i / sceneTrailPointCount);
      sceneTrailX[i] = point.x;
      sceneTrailY[i] = point.y;
    }
    for (let i = 0; i < budget.sceneSparkleCount; i++) {
      const trailIndex = Math.floor((i / Math.max(1, budget.sceneSparkleCount)) * sceneTrailPointCount);
      sceneSparkles.push({
        progress: trailIndex / sceneTrailPointCount,
        x: sceneTrailX[trailIndex],
        y: sceneTrailY[trailIndex],
        radius: 0.8 + (i % 4) * 0.24,
        phase: ((i * 2.39996322973) % (Math.PI * 2)),
        speed: 0.00062 + (i % 3) * 0.00011,
      });
    }

    sceneContext = sceneCanvas.getContext('2d');
    sceneFrontContext = sceneFrontCanvas.getContext('2d');
    if (!sceneContext || !sceneFrontContext) {
      sceneSparkles.length = 0;
      sceneCanvas.width = 1;
      sceneFrontCanvas.width = 1;
      sceneFrontCanvas.height = 1;
      sceneCanvas.height = 1;
      return;
    }
    sceneGlowSprite = createSceneGlowSprite();

    resizeSceneCanvas();
    if (sceneReducedMotion) {
      window.addEventListener('resize', resizeSceneCanvas);
      return;
    }
    sceneStage.addEventListener('pointermove', handleScenePointer, { passive: true });
    sceneStage.addEventListener('pointerleave', resetScenePointer);
    window.addEventListener('resize', resizeSceneCanvas);
    document.addEventListener('visibilitychange', handleSceneVisibility);
    initSceneOrientation();
    scheduleSceneSparkleFrame();
  }

  function destroyLandingScene() {
    if (sceneDestroyed) return;
    sceneDestroyed = true;
    sceneStage?.removeEventListener('pointermove', handleScenePointer);
    sceneStage?.removeEventListener('pointerleave', resetScenePointer);
    sceneStage?.removeEventListener('pointerup', requestSceneOrientationPermission);
    window.removeEventListener('resize', resizeSceneCanvas);
    document.removeEventListener('visibilitychange', handleSceneVisibility);
    detachSceneOrientation();
    pauseLandingScene(true);
    sceneSparkles.length = 0;
    if (sceneCanvas) {
      sceneCanvas.width = 1;
      sceneCanvas.height = 1;
    }
    if (sceneFrontCanvas) {
      sceneFrontCanvas.width = 1;
      sceneFrontCanvas.height = 1;
    }
    sceneContext = null;
    sceneFrontContext = null;
    sceneRearPath = null;
    sceneFrontPath = null;
    sceneGlowSprite = null;
    sceneStage = null;
    sceneBackground = null;
    sceneCanvas = null;
    sceneFrontCanvas = null;
    sceneForeground = null;
  }

  function teardownHeroResources() {
    if (heroDestroyed) return;
    heroDestroyed = true;
    openingFinalizer = null;
    destroyLandingScene();
    clearHeroScheduledWork();
    if (backgroundAudio) {
      backgroundAudio.pause();
      backgroundAudio.removeAttribute('src');
      backgroundAudio.load();
      backgroundAudio = null;
    }
    releaseSparkleCanvases();
  }

  function handleHeroPageHide(event: PageTransitionEvent) {
    if (!event.persisted) {
      teardownHeroResources();
      return;
    }

    sceneVisible = false;
    pauseLandingScene(true);
    clearHeroScheduledWork();
    backgroundAudio?.pause();
    releaseSparkleCanvases();
    const guestName = document.getElementById('guest-name-reveal');
    if (guestName) {
      guestName.style.width = 'auto';
      guestName.style.opacity = '1';
      guestName.classList.remove('is-revealing');
      guestName.classList.add('is-complete');
    }
  }

  function handleHeroPageShow(event: PageTransitionEvent) {
    if (event.persisted) {
      finalizeOpeningTransition();
      sceneVisible = !document.hidden;
      if (sceneVisible) scheduleSceneSparkleFrame();
      if (backgroundAudio) backgroundAudio.play().catch(() => {});
    }
  }

  window.addEventListener('pagehide', handleHeroPageHide);
  window.addEventListener('pageshow', handleHeroPageShow);

  // --- FEATHERED SOFT BLUR EDGE & LEADING SPARKLE REVEAL ENGINE ---
  function initFeatheredHandwritingSparkleReveal() {
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const budget = getRenderingBudget(window.innerWidth, motionQuery.matches);
    const lifecycleGeneration = heroLifecycleGeneration;
    const handwritingFont = '700 1em "Great Vibes"';
    const fontLoadTimeout = 1200;
    const sequences = [
      {
        wrapper: document.getElementById('guest-wrapper'),
        textEl: document.getElementById('guest-name-reveal'),
        glow: document.getElementById('guest-writing-glow'),
        canvas: document.getElementById('guest-sparkle-canvas') as HTMLCanvasElement | null,
        delay: 350,
        duration: 1500
      }
    ];

    sequences.forEach(({ wrapper, textEl, glow, canvas, delay, duration }) => {
      if (!wrapper || !textEl || !glow || !canvas) return;

      const sequenceWrapper = wrapper;
      const sequenceText = textEl;
      const sequenceGlow = glow;
      const sequenceCanvas = canvas;
      const dpr = budget.handwritingCanvasDpr;
      let ctx: CanvasRenderingContext2D | null = null;
      let fullW = 0;
      let finished = false;
      const motes: Mote[] = [];

      interface Mote {
        bornAt: number;
        duration: number;
        originX: number;
        originY: number;
        driftX: number;
        driftY: number;
        size: number;
      }

      function finishSequence() {
        if (finished) return;
        finished = true;
        sequenceWrapper.style.setProperty('--reveal-position', '100%');
        sequenceWrapper.style.setProperty('--reveal-x', `${fullW}px`);
        sequenceText.classList.remove('is-revealing');
        sequenceText.classList.add('is-complete');
        sequenceGlow.style.opacity = '0';
        ctx?.clearRect(0, 0, sequenceCanvas.width / dpr, sequenceCanvas.height / dpr);
        sequenceCanvas.style.display = 'none';
        sequenceCanvas.width = 1;
        sequenceCanvas.height = 1;
        motes.length = 0;
      }

      if (budget.handwritingParticleScale === 0) {
        finishSequence();
        return;
      }

      function startSequence() {
        fullW = Math.ceil(sequenceText.getBoundingClientRect().width || sequenceText.scrollWidth);
        const fullH = Math.ceil(sequenceText.getBoundingClientRect().height || sequenceText.scrollHeight);

        if (fullW <= 0 || fullH <= 0) {
          finishSequence();
          return;
        }

        ctx = sequenceCanvas.getContext('2d');
        if (!ctx) {
          finishSequence();
          return;
        }

        const padX = 30;
        const padY = 20;
        sequenceCanvas.width = Math.ceil((fullW + padX * 2) * dpr);
        sequenceCanvas.height = Math.ceil((fullH + padY * 2) * dpr);
        sequenceCanvas.style.width = `${fullW + padX * 2}px`;
        sequenceCanvas.style.height = `${fullH + padY * 2}px`;
        sequenceCanvas.style.left = `-${padX}px`;
        sequenceCanvas.style.top = `-${padY}px`;
        sequenceCanvas.style.display = 'block';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const colors = ['#FFF6D5', '#F6E597', '#D4AF37', '#FFFFFF', '#EECE5A'];
        const motePattern = [
          { offsetX: -3, offsetY: -6, driftX: -7, driftY: -13, size: 2.8, duration: 420 },
          { offsetX: 2, offsetY: 5, driftX: 8, driftY: 11, size: 2.2, duration: 360 },
          { offsetX: 5, offsetY: -1, driftX: 11, driftY: -7, size: 2.5, duration: 480 },
          { offsetX: -1, offsetY: 8, driftX: -4, driftY: 14, size: 2, duration: 400 },
        ];
        const centerY = padY + fullH * 0.52;
        let nextMotePattern = 0;
        let lastEmissionX = 0;

        function drawDiamondStar(x: number, y: number, r: number, rot: number, color: string, alpha: number) {
          if (!ctx) return;
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(rot);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.fillStyle = color;

          ctx.beginPath();
          for (let i = 0; i < 4; i++) {
            ctx.lineTo(Math.cos((i * Math.PI) / 2) * r, Math.sin((i * Math.PI) / 2) * r);
            ctx.lineTo(
              Math.cos((i * Math.PI) / 2 + Math.PI / 4) * (r * 0.22),
              Math.sin((i * Math.PI) / 2 + Math.PI / 4) * (r * 0.22)
            );
          }
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        sequenceText.classList.add('is-revealing');
        const startTime = performance.now();

        function renderFrame(now: number) {
          if (finished || !ctx) return;

          ctx.clearRect(0, 0, sequenceCanvas.width / dpr, sequenceCanvas.height / dpr);

          const rawProgress = Math.min(1, Math.max(0, (now - startTime) / duration));
          const progress = easeHandwritingProgress(rawProgress);
          const edgeX = fullW * progress;

          sequenceWrapper.style.setProperty('--reveal-position', `${progress * 100}%`);
          sequenceWrapper.style.setProperty('--reveal-x', `${edgeX}px`);
          sequenceGlow.style.opacity = String(Math.sin(Math.PI * rawProgress) * 0.9);

          if (rawProgress < 1) {
            drawDiamondStar(edgeX + padX, centerY, 5.5, Math.PI / 4, '#FFF6D5', 0.95);

            const spawnCount = getMoteSpawnCount(
              edgeX - lastEmissionX,
              budget.profile === 'mobile' ? 22 : 14,
              motes.length,
              budget.handwritingMoteLimit,
            );

            if (spawnCount > 0) {
              for (let i = 0; i < spawnCount; i++) {
                const pattern = motePattern[nextMotePattern % motePattern.length];
                nextMotePattern++;
                motes.push({
                  bornAt: now,
                  duration: pattern.duration,
                  originX: edgeX + padX + pattern.offsetX,
                  originY: centerY + pattern.offsetY,
                  driftX: pattern.driftX,
                  driftY: pattern.driftY,
                  size: pattern.size,
                });
              }
              lastEmissionX = edgeX;
            }
          }

          for (let i = motes.length - 1; i >= 0; i--) {
            const mote = motes[i];
            const age = now - mote.bornAt;
            if (age >= mote.duration) {
              motes.splice(i, 1);
              continue;
            }

            const moteProgress = Math.max(0, age / mote.duration);
            const alpha = Math.sin(Math.PI * moteProgress) * 0.85;
            drawDiamondStar(
              mote.originX + mote.driftX * moteProgress,
              mote.originY + mote.driftY * moteProgress,
              mote.size * Math.sin(Math.PI * moteProgress),
              Math.PI / 4 + moteProgress * 0.35,
              colors[i % colors.length],
              alpha,
            );
          }

          if (rawProgress < 1 || motes.length > 0) {
            scheduleHeroFrame(renderFrame);
          } else {
            finishSequence();
          }
        }

        scheduleHeroFrame(renderFrame);
      }

      function startWhenFontReady() {
        const sampleText = sequenceText.textContent?.trim() || 'Guest';
        let fontWaitFinished = false;

        function settleFontWait(fontLoaded: boolean) {
          if (fontWaitFinished) return;
          fontWaitFinished = true;

          if (
            heroDestroyed ||
            finished ||
            lifecycleGeneration !== heroLifecycleGeneration
          ) {
            return;
          }

          if (fontLoaded) {
            startSequence();
          } else {
            finishSequence();
          }
        }

        scheduleHeroTimeout(() => settleFontWait(false), fontLoadTimeout);
        document.fonts.load(handwritingFont, sampleText).then(
          (fontFaces) => settleFontWait(fontFaces.length > 0),
          () => settleFontWait(false),
        );
      }

      scheduleHeroTimeout(startWhenFontReady, delay);
    });
  }

  const GOOGLE_SHEETS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwwPB4mXKlNyNUIKocRuNXLbReyl71p00_-rFNv2oQ1s9lh4kXwjTIYTJ09H37nJ_U6/exec";

  function startBackgroundAudio() {
    if (backgroundAudio) return;
    backgroundAudio = new Audio('/audio/bgm.mp3');
    backgroundAudio.loop = true;
    backgroundAudio.volume = 0;

    backgroundAudio.play().then(() => {
      let volume = 0;
      audioFadeInterval = window.setInterval(() => {
        if (!backgroundAudio) return;
        volume += 0.03;
        if (volume >= 0.35) {
          backgroundAudio.volume = 0.35;
          if (audioFadeInterval !== null) clearInterval(audioFadeInterval);
          audioFadeInterval = null;
        } else {
          backgroundAudio.volume = volume;
        }
      }, 80);
    }).catch((err) => {
      console.log('Audio playback initialized:', err);
      backgroundAudio = null;
    });
  }

  function initOpeningTransition() {
    const btn = document.getElementById('accept-invitation-btn') as HTMLButtonElement | null;
    const splash = document.getElementById('splash-screen');
    const mainContent = document.getElementById('main-revealed-content');

    if (!btn || !splash) return;

    btn.addEventListener('click', () => {
      if (btn.disabled || heroDestroyed) return;
      btn.disabled = true;

      // 0. Log Splash Invitation Acceptance to Google Sheets
      const guestName = btn.getAttribute('data-guest-name') || 'Honored Guest';
      const guestRole = btn.getAttribute('data-guest-role') || 'Honored Guest';

      if (GOOGLE_SHEETS_SCRIPT_URL) {
        try {
          fetch(GOOGLE_SHEETS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              guestName: guestName,
              role: guestRole,
              action: 'accept_splash',
              attendance: 'Opened Splash (Accepted)',
              timestamp: new Date().toISOString()
            })
          }).catch(err => console.warn('Splash tracking note:', err));
        } catch(e) {}
      }

      // 1. Play processed background music continuously in a loop upon accepting invitation
      try {
        startBackgroundAudio();
      } catch(e) {}

      const budget = getRenderingBudget(
        window.innerWidth,
        window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      );
      splash.classList.add(budget.profile === 'reduced' ? 'opening-reduced' : 'opening-enchanted');
      document.querySelectorAll<HTMLElement>('.unseal-mote').forEach((mote, index) => {
        mote.hidden = index >= budget.transitionMotes;
      });
      mainContent?.classList.remove('hidden-main');
      mainContent?.classList.add('revealed-active');

      openingFinalizer = () => {
        splash.classList.add('splash-dismissed');
        splash.style.display = 'none';
        window.scrollTo(0, 0);
        document.body.classList.remove('splash-locked');
        if (sceneCanvas) {
          sceneCanvas.width = 1;
          sceneCanvas.height = 1;
        }
        if (sceneFrontCanvas) {
          sceneFrontCanvas.width = 1;
          sceneFrontCanvas.height = 1;
        }
        destroyLandingScene();
      };
      scheduleHeroTimeout(finalizeOpeningTransition, budget.profile === 'reduced' ? 180 : 900);
    }, { once: true });
  }

  function onReady(fn: () => void) {
    if (document.readyState !== 'loading') {
      fn();
    } else {
      document.addEventListener('DOMContentLoaded', fn);
    }
  }

  onReady(() => {
    initLandingScene();
    initFeatheredHandwritingSparkleReveal();
    initOpeningTransition();
  });
</script>

