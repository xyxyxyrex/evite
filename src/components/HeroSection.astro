---
import { Image } from 'astro:assets';
import landingImg from '../assets/LandingPage.jpg';
import type { GuestInfo } from '../utils/guests';

export interface Props {
  guestInfo: GuestInfo;
  debutanteName?: string;
  debutDate?: string;
  venueName?: string;
}

const {
  guestInfo,
  debutanteName = "Rysha Isabel Trovillas"
} = Astro.props;
---

<!-- Fixed Fullscreen Splash Screen Overlay (Zero Scroll, Mobile Viewport Optimized) -->
<div id="splash-screen" class="splash-overlay">
  
  <div class="splash-split-container container-custom">
    
    <!-- Left Column (Desktop) / Bottom Column (Mobile): Debutante Portrait Photo Frame -->
    <div class="splash-photo-col glass-card">
      <div class="photo-frame-wrapper">
        <Image 
          src={landingImg} 
          alt="Rysha Isabel Trovillas 18th Debut" 
          width={720}
          quality={82}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="splash-portrait-img"
        />
        <div class="photo-vignette-overlay"></div>
        <div class="photo-gold-border"></div>
        <div class="photo-tag-badge font-serif">✦ Isabel | XVIII ✦</div>
      </div>
    </div>

    <!-- Right Column (Desktop) / Top Column (Mobile): Personalized Invitation Details (Ornate Gilded Frame) -->
    <div class="splash-info-col glass-card ornate-gilded-card">
      
      <!-- Inner Gold Border Frame -->
      <div class="card-gold-border-frame"></div>

      <!-- 4 Corner Pure Diamond Stars -->
      <div class="corner-star top-left">✦</div>
      <div class="corner-star top-right">✦</div>
      <div class="corner-star bottom-left">✦</div>
      <div class="corner-star bottom-right">✦</div>

      <svg class="corner-filigree top-left-filigree" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 33V10C2 5.57868 5.57868 2 10 2H33" stroke="url(#goldGradFiligree)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      
      <svg class="corner-filigree top-right-filigree" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M33 33V10C33 5.57868 29.4213 2 25 2H2" stroke="url(#goldGradFiligree)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>

      <svg class="corner-filigree bottom-left-filigree" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 2V25C2 29.4213 5.57868 33 10 33H33" stroke="url(#goldGradFiligree)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>

      <svg class="corner-filigree bottom-right-filigree" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M33 2V25C33 29.4213 29.4213 33 25 33H2" stroke="url(#goldGradFiligree)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>

      <svg style="width:0;height:0;position:absolute;">
        <defs>
          <linearGradient id="goldGradFiligree" x1="0" y1="0" x2="35" y2="35" gradientUnits="userSpaceOnUse">
            <stop stop-color="#FBF3CB"/>
            <stop offset="0.5" stop-color="#D4AF37"/>
            <stop offset="1" stop-color="#B38E22"/>
          </linearGradient>
        </defs>
      </svg>

      <!-- Botanical Top Ornament -->
      <div class="botanical-top">
        <svg class="botanical-svg" viewBox="0 0 200 35" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M100 30C120 30 140 16 180 16M100 30C80 30 60 16 20 16" stroke="url(#goldGradSplash)" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="100" cy="30" r="3.5" fill="url(#goldGradSplash)"/>
          <circle cx="140" cy="20" r="2" fill="#D4AF37"/>
          <circle cx="60" cy="20" r="2" fill="#D4AF37"/>
          <path d="M100 10 L103 18 L112 18 L105 23 L108 32 L100 27 L92 32 L95 23 L88 18 L97 18 Z" fill="url(#goldGradSplash)" opacity="0.9"/>
          <defs>
            <linearGradient id="goldGradSplash" x1="0" y1="0" x2="200" y2="0" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FBF3CB"/>
              <stop offset="0.5" stop-color="#D4AF37"/>
              <stop offset="1" stop-color="#B38E22"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- 18th Crest Monogram -->
      <div class="monogram-wrapper animate-float">
        <div class="crest-ring">
          <span class="monogram-number font-serif">18</span>
        </div>
      </div>

      <!-- Personalized VIP Greeting (Feathered Soft Blur Edge Reveal + Leading Sparkles) -->
      <div class="greeting-box">
        <h1 class="guest-greeting text-gold-gradient font-serif">
          Hi,&nbsp;<span class="guest-sparkle-wrapper inline-reveal-wrapper" id="guest-wrapper">
            <span class="guest-name-text font-cursive text-gold-gradient inline-reveal-text" id="guest-name-reveal">
              {guestInfo.rawName}
            </span>
            <span class="guest-writing-glow" id="guest-writing-glow" aria-hidden="true"></span>
            <canvas class="sparkle-leading-canvas" id="guest-sparkle-canvas" aria-hidden="true"></canvas>
          </span>!
        </h1>
      </div>

      <!-- Golden Line Divider Top -->
      <div class="ornate-line-divider">
        <span class="divider-line"></span>
        <span class="divider-diamond font-serif">✦</span>
        <span class="divider-line"></span>
      </div>

      <div class="invitation-text-block">
        <p class="invitation-subtitle font-serif">An 18th Birthday Debut Celebration</p>

        <!-- Debutante Name -->
        <div class="debutante-title-wrapper">
          <h2 class="debutante-name font-cursive text-gold-gradient" id="debutante-name-display">
            {debutanteName}
          </h2>
        </div>

        <p class="invitation-lead font-serif-sub">is turning 18 & cordially requests your presence at her debut celebration</p>
        
        <div class="cursive-announcement-wrapper">
          <h3 class="cursive-invitation font-cursive text-gold-gradient">
            You are invited to my 18th Birthday Debut!
          </h3>
        </div>

        <!-- Accept Invitation CTA Button -->
        <div class="hero-actions">
          <button 
            class="btn-gold btn-reveal" 
            id="accept-invitation-btn"
            data-guest-name={guestInfo.rawName}
            data-guest-role={guestInfo.role}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span>Accept Invitation & Open ✦</span>
          </button>
        </div>

      </div>

    </div>

  </div>

</div>

<script>
  import confetti from 'canvas-confetti';
  import {
    easeHandwritingProgress,
    getMoteSpawnCount,
  } from '../utils/handwriting';
  import { getRenderingBudget } from '../utils/performance';

  const heroAnimationFrames = new Set<number>();
  const heroTimeouts = new Set<number>();
  let backgroundAudio: HTMLAudioElement | null = null;
  let audioFadeInterval: number | null = null;
  let heroDestroyed = false;

  function scheduleHeroFrame(callback: FrameRequestCallback) {
    const id = requestAnimationFrame((time) => {
      heroAnimationFrames.delete(id);
      if (!heroDestroyed) callback(time);
    });
    heroAnimationFrames.add(id);
    return id;
  }

  function scheduleHeroTimeout(callback: () => void, delay: number) {
    const id = window.setTimeout(() => {
      heroTimeouts.delete(id);
      if (!heroDestroyed) callback();
    }, delay);
    heroTimeouts.add(id);
    return id;
  }

  function clearHeroScheduledWork() {
    heroAnimationFrames.forEach((id) => cancelAnimationFrame(id));
    heroAnimationFrames.clear();
    heroTimeouts.forEach((id) => clearTimeout(id));
    heroTimeouts.clear();
    if (audioFadeInterval !== null) clearInterval(audioFadeInterval);
    audioFadeInterval = null;
  }

  function releaseSparkleCanvases() {
    document.querySelectorAll<HTMLCanvasElement>('.sparkle-overlay-canvas, .sparkle-leading-canvas').forEach((canvas) => {
      canvas.style.display = 'none';
      canvas.width = 1;
      canvas.height = 1;
    });
    const glow = document.getElementById('guest-writing-glow');
    if (glow) glow.style.opacity = '0';
  }

  function teardownHeroResources() {
    if (heroDestroyed) return;
    heroDestroyed = true;
    clearHeroScheduledWork();
    if (backgroundAudio) {
      backgroundAudio.pause();
      backgroundAudio.removeAttribute('src');
      backgroundAudio.load();
      backgroundAudio = null;
    }
    confetti.reset();
    releaseSparkleCanvases();
  }

  function handleHeroPageHide(event: PageTransitionEvent) {
    if (!event.persisted) {
      teardownHeroResources();
      return;
    }

    clearHeroScheduledWork();
    backgroundAudio?.pause();
    confetti.reset();
    releaseSparkleCanvases();
    const guestName = document.getElementById('guest-name-reveal');
    if (guestName) {
      guestName.style.width = 'auto';
      guestName.style.opacity = '1';
      guestName.classList.remove('is-revealing');
      guestName.classList.add('is-complete');
    }
  }

  function handleHeroPageShow(event: PageTransitionEvent) {
    if (event.persisted && backgroundAudio) {
      backgroundAudio.play().catch(() => {});
    }
  }

  window.addEventListener('pagehide', handleHeroPageHide);
  window.addEventListener('pageshow', handleHeroPageShow);

  // --- FEATHERED SOFT BLUR EDGE & LEADING SPARKLE REVEAL ENGINE ---
  function initFeatheredHandwritingSparkleReveal() {
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const budget = getRenderingBudget(window.innerWidth, motionQuery.matches);
    const sequences = [
      {
        wrapper: document.getElementById('guest-wrapper'),
        textEl: document.getElementById('guest-name-reveal'),
        glow: document.getElementById('guest-writing-glow'),
        canvas: document.getElementById('guest-sparkle-canvas') as HTMLCanvasElement | null,
        delay: 350,
        duration: 1500
      }
    ];

    sequences.forEach(({ wrapper, textEl, glow, canvas, delay, duration }) => {
      if (!wrapper || !textEl || !glow || !canvas) return;

      const sequenceWrapper = wrapper;
      const sequenceText = textEl;
      const sequenceGlow = glow;
      const sequenceCanvas = canvas;
      const dpr = budget.handwritingCanvasDpr;
      let ctx: CanvasRenderingContext2D | null = null;
      let fullW = 0;
      let finished = false;
      const motes: Mote[] = [];

      interface Mote {
        bornAt: number;
        duration: number;
        originX: number;
        originY: number;
        driftX: number;
        driftY: number;
        size: number;
      }

      function finishSequence() {
        if (finished) return;
        finished = true;
        sequenceWrapper.style.setProperty('--reveal-position', '100%');
        sequenceWrapper.style.setProperty('--reveal-x', `${fullW}px`);
        sequenceText.classList.remove('is-revealing');
        sequenceText.classList.add('is-complete');
        sequenceGlow.style.opacity = '0';
        ctx?.clearRect(0, 0, sequenceCanvas.width / dpr, sequenceCanvas.height / dpr);
        sequenceCanvas.style.display = 'none';
        sequenceCanvas.width = 1;
        sequenceCanvas.height = 1;
        motes.length = 0;
      }

      if (budget.handwritingParticleScale === 0) {
        finishSequence();
        return;
      }

      function startSequence() {
        fullW = Math.ceil(sequenceText.getBoundingClientRect().width || sequenceText.scrollWidth);
        const fullH = Math.ceil(sequenceText.getBoundingClientRect().height || sequenceText.scrollHeight);

        if (fullW <= 0 || fullH <= 0) {
          finishSequence();
          return;
        }

        ctx = sequenceCanvas.getContext('2d');
        if (!ctx) {
          finishSequence();
          return;
        }

        const padX = 30;
        const padY = 20;
        sequenceCanvas.width = Math.ceil((fullW + padX * 2) * dpr);
        sequenceCanvas.height = Math.ceil((fullH + padY * 2) * dpr);
        sequenceCanvas.style.width = `${fullW + padX * 2}px`;
        sequenceCanvas.style.height = `${fullH + padY * 2}px`;
        sequenceCanvas.style.left = `-${padX}px`;
        sequenceCanvas.style.top = `-${padY}px`;
        sequenceCanvas.style.display = 'block';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const colors = ['#FFF6D5', '#F6E597', '#D4AF37', '#FFFFFF', '#EECE5A'];
        const motePattern = [
          { offsetX: -3, offsetY: -6, driftX: -7, driftY: -13, size: 2.8, duration: 420 },
          { offsetX: 2, offsetY: 5, driftX: 8, driftY: 11, size: 2.2, duration: 360 },
          { offsetX: 5, offsetY: -1, driftX: 11, driftY: -7, size: 2.5, duration: 480 },
          { offsetX: -1, offsetY: 8, driftX: -4, driftY: 14, size: 2, duration: 400 },
        ];
        const centerY = padY + fullH * 0.52;
        let nextMotePattern = 0;
        let lastEmissionX = 0;

        function drawDiamondStar(x: number, y: number, r: number, rot: number, color: string, alpha: number) {
          if (!ctx) return;
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(rot);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.fillStyle = color;

          ctx.beginPath();
          for (let i = 0; i < 4; i++) {
            ctx.lineTo(Math.cos((i * Math.PI) / 2) * r, Math.sin((i * Math.PI) / 2) * r);
            ctx.lineTo(
              Math.cos((i * Math.PI) / 2 + Math.PI / 4) * (r * 0.22),
              Math.sin((i * Math.PI) / 2 + Math.PI / 4) * (r * 0.22)
            );
          }
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        sequenceText.classList.add('is-revealing');
        const startTime = performance.now();

        function renderFrame(now: number) {
          if (finished || !ctx) return;

          ctx.clearRect(0, 0, sequenceCanvas.width / dpr, sequenceCanvas.height / dpr);

          const rawProgress = Math.min(1, Math.max(0, (now - startTime) / duration));
          const progress = easeHandwritingProgress(rawProgress);
          const edgeX = fullW * progress;

          sequenceWrapper.style.setProperty('--reveal-position', `${progress * 100}%`);
          sequenceWrapper.style.setProperty('--reveal-x', `${edgeX}px`);
          sequenceGlow.style.opacity = String(Math.sin(Math.PI * rawProgress) * 0.9);

          if (rawProgress < 1) {
            drawDiamondStar(edgeX + padX, centerY, 5.5, Math.PI / 4, '#FFF6D5', 0.95);

            const spawnCount = getMoteSpawnCount(
              edgeX - lastEmissionX,
              budget.profile === 'mobile' ? 22 : 14,
              motes.length,
              budget.handwritingMoteLimit,
            );

            if (spawnCount > 0) {
              for (let i = 0; i < spawnCount; i++) {
                const pattern = motePattern[nextMotePattern % motePattern.length];
                nextMotePattern++;
                motes.push({
                  bornAt: now,
                  duration: pattern.duration,
                  originX: edgeX + padX + pattern.offsetX,
                  originY: centerY + pattern.offsetY,
                  driftX: pattern.driftX,
                  driftY: pattern.driftY,
                  size: pattern.size,
                });
              }
              lastEmissionX = edgeX;
            }
          }

          for (let i = motes.length - 1; i >= 0; i--) {
            const mote = motes[i];
            const age = now - mote.bornAt;
            if (age >= mote.duration) {
              motes.splice(i, 1);
              continue;
            }

            const moteProgress = Math.max(0, age / mote.duration);
            const alpha = Math.sin(Math.PI * moteProgress) * 0.85;
            drawDiamondStar(
              mote.originX + mote.driftX * moteProgress,
              mote.originY + mote.driftY * moteProgress,
              mote.size * Math.sin(Math.PI * moteProgress),
              Math.PI / 4 + moteProgress * 0.35,
              colors[i % colors.length],
              alpha,
            );
          }

          if (rawProgress < 1 || motes.length > 0) {
            scheduleHeroFrame(renderFrame);
          } else {
            finishSequence();
          }
        }

        scheduleHeroFrame(renderFrame);
      }

      scheduleHeroTimeout(startSequence, delay);
    });
  }

  const GOOGLE_SHEETS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwwPB4mXKlNyNUIKocRuNXLbReyl71p00_-rFNv2oQ1s9lh4kXwjTIYTJ09H37nJ_U6/exec";

  function startBackgroundAudio() {
    if (backgroundAudio) return;
    backgroundAudio = new Audio('/audio/bgm.mp3');
    backgroundAudio.loop = true;
    backgroundAudio.volume = 0;

    backgroundAudio.play().then(() => {
      let volume = 0;
      audioFadeInterval = window.setInterval(() => {
        if (!backgroundAudio) return;
        volume += 0.03;
        if (volume >= 0.35) {
          backgroundAudio.volume = 0.35;
          if (audioFadeInterval !== null) clearInterval(audioFadeInterval);
          audioFadeInterval = null;
        } else {
          backgroundAudio.volume = volume;
        }
      }, 80);
    }).catch((err) => {
      console.log('Audio playback initialized:', err);
      backgroundAudio = null;
    });
  }

  function initOpeningTransition() {
    const btn = document.getElementById('accept-invitation-btn');
    const splash = document.getElementById('splash-screen');
    const mainContent = document.getElementById('main-revealed-content');

    if (!btn || !splash) return;

    btn.addEventListener('click', () => {
      // 0. Log Splash Invitation Acceptance to Google Sheets
      const guestName = btn.getAttribute('data-guest-name') || 'Honored Guest';
      const guestRole = btn.getAttribute('data-guest-role') || 'Honored Guest';

      if (GOOGLE_SHEETS_SCRIPT_URL) {
        try {
          fetch(GOOGLE_SHEETS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              guestName: guestName,
              role: guestRole,
              action: 'accept_splash',
              attendance: 'Opened Splash (Accepted)',
              timestamp: new Date().toISOString()
            })
          }).catch(err => console.warn('Splash tracking note:', err));
        } catch(e) {}
      }

      // 1. Play processed background music continuously in a loop upon accepting invitation
      try {
        startBackgroundAudio();
      } catch(e) {}

      // 2. Confetti explosion (scaled for mobile performance)
      const budget = getRenderingBudget(
        window.innerWidth,
        window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      );
      if (budget.confettiParticles > 0) {
        confetti({
          particleCount: budget.confettiParticles,
          spread: budget.profile === 'mobile' ? 75 : 100,
          origin: { y: 0.5 },
          colors: ['#D4AF37', '#F6E597', '#0B132B', '#FFFFFF', '#EECE5A']
        });
      }

      // 3. Splash curtain transition
      splash.classList.add('opening-transition');

      if (mainContent) {
        mainContent.classList.remove('hidden-main');
        mainContent.classList.add('revealed-active');
      }

      window.scrollTo(0, 0);
      document.body.classList.remove('splash-locked');

      scheduleHeroTimeout(() => {
        splash.classList.add('splash-dismissed');
        splash.style.display = 'none';
      }, 1100);
    }, { once: true });
  }

  function onReady(fn: () => void) {
    if (document.readyState !== 'loading') {
      fn();
    } else {
      document.addEventListener('DOMContentLoaded', fn);
    }
  }

  onReady(() => {
    initFeatheredHandwritingSparkleReveal();
    initOpeningTransition();
  });
</script>

<style>
  /* Ornate Gilded Frame & Corner Stars */
  .ornate-gilded-card {
    position: relative;
  }

  .card-gold-border-frame {
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 12px;
    pointer-events: none;
    z-index: 2;
  }

  .corner-star {
    position: absolute;
    color: var(--gold-300);
    font-size: 0.95rem;
    line-height: 1;
    z-index: 5;
    pointer-events: none;
    filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.7));
  }

  .corner-star.top-left { top: 12px; left: 14px; }
  .corner-star.top-right { top: 12px; right: 14px; }
  .corner-star.bottom-left { bottom: 12px; left: 14px; }
  .corner-star.bottom-right { bottom: 12px; right: 14px; }

  .corner-filigree {
    position: absolute;
    width: 32px;
    height: 32px;
    pointer-events: none;
    z-index: 3;
    opacity: 0.85;
  }

  .top-left-filigree { top: 5px; left: 5px; }
  .top-right-filigree { top: 5px; right: 5px; }
  .bottom-left-filigree { bottom: 5px; left: 5px; }
  .bottom-right-filigree { bottom: 5px; right: 5px; }

  .ornate-line-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 80%;
    margin: 0.25rem 0 0.35rem 0;
    opacity: 0.85;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-500), transparent);
  }

  .divider-diamond {
    color: var(--gold-300);
    font-size: 0.75rem;
  }

  /* Inline Handwriting Reveal with Soft Feathered Edge Masking */
  .inline-reveal-wrapper {
    --reveal-position: 0%;
    --reveal-x: 0px;
    position: relative;
    display: inline-flex;
    align-items: baseline;
    vertical-align: baseline;
    isolation: isolate;
  }

  .inline-reveal-text {
    display: inline-block;
    vertical-align: baseline;
    white-space: nowrap;
    opacity: 1;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(var(--reveal-position) - 18px),
      rgba(0, 0, 0, 0.75) calc(var(--reveal-position) - 8px),
      transparent var(--reveal-position),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(var(--reveal-position) - 18px),
      rgba(0, 0, 0, 0.75) calc(var(--reveal-position) - 8px),
      transparent var(--reveal-position),
      transparent 100%
    );
  }

  .inline-reveal-text.is-revealing {
    opacity: 1;
  }

  .inline-reveal-text.is-complete {
    width: auto !important;
    overflow: visible !important;
    opacity: 1 !important;
    -webkit-mask-image: none !important;
    mask-image: none !important;
    filter: none !important;
    -webkit-filter: none !important;
  }

  .guest-writing-glow {
    position: absolute;
    left: 0;
    top: 52%;
    width: 58px;
    height: 42px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--reveal-x), -50%, 0) translateX(-50%);
    background: radial-gradient(ellipse, rgba(255, 239, 166, 0.42) 0%, rgba(224, 174, 55, 0.16) 42%, transparent 74%);
  }

  .sparkle-leading-canvas {
    position: absolute;
    pointer-events: none;
    z-index: 10;
  }

  /* Fixed Fullscreen Splash Overlay - Dynamic Viewport (100dvh) */
  .splash-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    z-index: 9999;
    background: radial-gradient(circle at 50% 40%, #0b132b 0%, #060b19 60%, #030611 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom)) 0.5rem;
    overflow: hidden;
    transition: transform 1.1s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.9s ease;
