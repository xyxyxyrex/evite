---

<!-- Enchanted Magic Preloader Overlay -->
<div id="magic-preloader" class="magic-preloader-overlay">
  <div class="preloader-content-box">
    
    <!-- Magic Spinning Crest Element -->
    <div class="magic-spinner-container">
      <!-- Outer Filigree Rotating Gold Ring -->
      <div class="spinner-ring outer-ring"></div>
      <!-- Inner Reverse-Rotating Gold Ring -->
      <div class="spinner-ring inner-ring"></div>
      
      <!-- Center Gold Monogram Crest -->
      <div class="center-crest font-serif">
        <span class="crest-number">XVIII</span>
      </div>

      <!-- 4 Pulsating Starlight Diamond Accents -->
      <span class="star-accent star-top font-serif">✦</span>
      <span class="star-accent star-bottom font-serif">✦</span>
      <span class="star-accent star-left font-serif">✦</span>
      <span class="star-accent star-right font-serif">✦</span>
    </div>

    <!-- Luxury Subtitle & Announcement -->
    <div class="preloader-text-block text-center font-serif">
      <span class="preloader-badge">✦ CHAPTER XVIII ✦</span>
      <h2 class="preloader-title text-gold-gradient">Isabel | Debut Celebration</h2>
      <p class="preloader-status font-serif-sub" id="preloader-status-text">Preparing your enchanted invitation...</p>
    </div>

    <!-- Shimmering Golden Progress Line -->
    <div class="preloader-progress-bar">
      <div class="progress-fill" id="preloader-progress-fill"></div>
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    const preloader = document.getElementById('magic-preloader');
    const fill = document.getElementById('preloader-progress-fill');
    if (!preloader) return;

    let finished = false;
    let progress = 10;
    const progressInterval = setInterval(function() {
      if (progress < 85 && fill) {
        progress += Math.random() * 12;
        fill.style.width = Math.min(progress, 85) + '%';
      }
    }, 120);
    let fallbackTimeout = 0;
    let revealTimeout = 0;
    let removalTimeout = 0;
    const imageListeners = [];

    function clearImageListeners() {
      imageListeners.forEach(function(entry) {
        entry.image.removeEventListener('load', entry.settle);
        entry.image.removeEventListener('error', entry.settle);
      });
      imageListeners.length = 0;
    }

    function hidePreloader() {
      if (finished) return;
      finished = true;
      clearInterval(progressInterval);
      clearTimeout(fallbackTimeout);
      window.removeEventListener('load', beginCriticalImageWait);
      clearImageListeners();
      if (fill) fill.style.width = '100%';

      revealTimeout = window.setTimeout(function() {
        preloader.classList.add('preloader-hidden');
        removalTimeout = window.setTimeout(function() {
          preloader.style.display = 'none';
        }, 600);
      }, 300);
    }

    function beginCriticalImageWait() {
      const images = Array.from(document.querySelectorAll('img[loading="eager"]'));
      const pending = images.filter(function(image) { return !image.complete; });
      if (pending.length === 0) {
        hidePreloader();
        return;
      }

      let remaining = pending.length;
      pending.forEach(function(image) {
        const settle = function() {
          image.removeEventListener('load', settle);
          image.removeEventListener('error', settle);
          remaining -= 1;
          if (remaining === 0) hidePreloader();
        };
        imageListeners.push({ image: image, settle: settle });
        image.addEventListener('load', settle, { once: true });
        image.addEventListener('error', settle, { once: true });
      });
    }

    function cleanupImmediately() {
      finished = true;
      clearInterval(progressInterval);
      clearTimeout(fallbackTimeout);
      clearTimeout(revealTimeout);
      clearTimeout(removalTimeout);
      window.removeEventListener('load', beginCriticalImageWait);
      clearImageListeners();
      preloader.style.display = 'none';
    }

    if (document.readyState === 'complete') {
      beginCriticalImageWait();
    } else {
      window.addEventListener('load', beginCriticalImageWait, { once: true });
    }
    fallbackTimeout = window.setTimeout(hidePreloader, 3500);
    window.addEventListener('pagehide', cleanupImmediately, { once: true });
  })();
</script>

<style>
  .magic-preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999999;
    background: #060B19;
    background: radial-gradient(circle at 50% 40%, #0F1934 0%, #050914 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s ease;
    opacity: 1;
    visibility: visible;
  }

  .magic-preloader-overlay.preloader-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .preloader-content-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
  }

  /* Magic Spinner Assembly */
  .magic-spinner-container {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinner-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  .outer-ring {
    border: 1.5px dashed rgba(212, 175, 55, 0.6);
    box-shadow: 0 0 25px rgba(212, 175, 55, 0.25);
    animation: rotateClockwise 12s linear infinite;
  }

  .inner-ring {
    inset: 12px;
    border: 1.5px solid transparent;
    border-top-color: #FDF3CB;
    border-bottom-color: #D4AF37;
    animation: rotateCounterClockwise 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .center-crest {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(212, 175, 55, 0.3) 0%, rgba(11, 19, 43, 0.9) 100%);
    border: 1px solid #D4AF37;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
    z-index: 2;
  }

  .crest-number {
    font-size: 1rem;
    font-weight: bold;
    letter-spacing: 0.15em;
    color: #FFEA9F;
    text-shadow: 0 0 10px rgba(212, 175, 55, 0.8);
  }

  /* 4 Star Accents around spinner */
  .star-accent {
    position: absolute;
    color: #D4AF37;
    font-size: 0.8rem;
    animation: starPulse 2s ease-in-out infinite alternate;
  }

  .star-top { top: -6px; left: 50%; transform: translateX(-50%); }
  .star-bottom { bottom: -6px; left: 50%; transform: translateX(-50%); }
  .star-left { left: -6px; top: 50%; transform: translateY(-50%); }
  .star-right { right: -6px; top: 50%; transform: translateY(-50%); }

  /* Typography & Badges */
  .preloader-badge {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: #D4AF37;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .preloader-title {
    font-size: 1.6rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0 0 0.4rem 0;
  }

  .preloader-status {
    font-size: 0.85rem;
    color: rgba(245, 245, 240, 0.7);
    margin: 0;
  }

  /* Golden Shimmering Progress Bar */
  .preloader-progress-bar {
    width: 180px;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .progress-fill {
    height: 100%;
    width: 10%;
    background: linear-gradient(90deg, #D4AF37, #FFEA9F, #D4AF37);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.8);
    transition: width 0.25s ease;
  }

  @keyframes rotateClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotateCounterClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @keyframes starPulse {
    from { opacity: 0.3; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1.15); filter: drop-shadow(0 0 8px #FFEA9F); }
  }
</style>
