---
export interface Props {
  tone?: "purple" | "red";
}

const { tone = "purple" } = Astro.props;

const petals = [
  { left: "4%", size: 13, duration: "12.8s", delay: "-7.2s", drift: "52px", turn: "310deg", variant: "a" },
  { left: "14%", size: 10, duration: "15.2s", delay: "-1.4s", drift: "-38px", turn: "-280deg", variant: "b" },
  { left: "25%", size: 16, duration: "13.9s", delay: "-10.1s", drift: "64px", turn: "390deg", variant: "a" },
  { left: "36%", size: 11, duration: "16.4s", delay: "-5.8s", drift: "-46px", turn: "-330deg", variant: "b" },
  { left: "47%", size: 14, duration: "14.7s", delay: "-12.5s", drift: "44px", turn: "300deg", variant: "a" },
  { left: "58%", size: 9, duration: "12.2s", delay: "-3.5s", drift: "-52px", turn: "-370deg", variant: "b" },
  { left: "67%", size: 15, duration: "16.8s", delay: "-8.8s", drift: "58px", turn: "420deg", variant: "a" },
  { left: "76%", size: 11, duration: "13.4s", delay: "-11.7s", drift: "-42px", turn: "-310deg", variant: "b" },
  { left: "86%", size: 14, duration: "15.7s", delay: "-4.6s", drift: "48px", turn: "360deg", variant: "a" },
  { left: "94%", size: 10, duration: "12.9s", delay: "-9.4s", drift: "-55px", turn: "-400deg", variant: "b" },
];
---

<div class:list={["petal-overlay", `tone-${tone}`]} data-petal-overlay aria-hidden="true">
  {petals.map((petal) => (
    <span
      class:list={["falling-petal", `variant-${petal.variant}`]}
      style={`--petal-left:${petal.left};--petal-size:${petal.size}px;--petal-duration:${petal.duration};--petal-delay:${petal.delay};--petal-drift:${petal.drift};--petal-turn:${petal.turn}`}
    >
      <svg viewBox="0 0 20 28" focusable="false">
        <path d="M10 1C4.1 4.2 1.2 10.1 3.3 16.1 5.1 21.3 9.2 25.1 10 27c.8-1.9 4.9-5.7 6.7-10.9C18.8 10.1 15.9 4.2 10 1Z" />
        <path class="petal-vein" d="M10 4.5c-.4 6.2-.35 12.4 0 18.5" fill="none" />
      </svg>
    </span>
  ))}
</div>

<script>
  const petalOverlays = document.querySelectorAll<HTMLElement>("[data-petal-overlay]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reducedMotion && "IntersectionObserver" in window) {
    const petalObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("is-active", entry.isIntersecting);
      });
    }, { threshold: 0.08, rootMargin: "8% 0px" });

    petalOverlays.forEach((overlay) => petalObserver.observe(overlay));
  } else if (!reducedMotion) {
    petalOverlays.forEach((overlay) => overlay.classList.add("is-active"));
  }
</script>

<style>
  .petal-overlay {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .tone-purple {
    --petal-primary: #8b5cf6;
    --petal-secondary: #c4b5fd;
    --petal-vein: #ede9fe;
  }

  .tone-red {
    --petal-primary: #dc143c;
    --petal-secondary: #fb7185;
    --petal-vein: #ffe4e6;
  }

  .falling-petal {
    position: absolute;
    top: -14%;
    left: var(--petal-left);
    display: block;
    width: var(--petal-size);
    color: var(--petal-primary);
    opacity: 0;
    filter: drop-shadow(0 2px 3px rgba(3, 6, 17, 0.35));
    animation: petal-fall var(--petal-duration) linear var(--petal-delay) infinite;
    animation-play-state: paused;
    will-change: transform, opacity;
  }

  .petal-overlay.is-active .falling-petal {
    animation-play-state: running;
  }

  .falling-petal.variant-b {
    color: var(--petal-secondary);
  }

  .falling-petal svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .falling-petal svg > :first-child {
    fill: currentColor;
    fill-opacity: 0.82;
  }

  .petal-vein {
    stroke: var(--petal-vein);
    stroke-width: 0.65;
    stroke-linecap: round;
    opacity: 0.46;
  }

  @keyframes petal-fall {
    0% {
      opacity: 0;
      transform: translate3d(0, -12px, 0) rotate(0deg) rotateY(0deg);
    }
    8% {
      opacity: 0.78;
    }
    48% {
      transform: translate3d(var(--petal-drift), 56vh, 0) rotate(180deg) rotateY(155deg);
    }
    92% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translate3d(0, 115vh, 0) rotate(var(--petal-turn)) rotateY(330deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .petal-overlay {
      display: none;
    }
  }
</style>
