---
import { Image } from "astro:assets";
import glassPortraitOne from "../assets/glass1.png";
import glassPortraitTwo from "../assets/glass2.png";
import StoryGallery from "./StoryGallery.astro";
import CountdownTimer from "./CountdownTimer.astro";
import VenueSection from "./VenueSection.astro";
import DressCodeSection from "./DressCodeSection.astro";
import GuestListSection from "./GuestListSection.astro";
import RSVPModal from "./RSVPModal.astro";
import Footer from "./Footer.astro";
import type { GuestInfo } from "../utils/guests";

export interface Props {
  guestInfo: GuestInfo;
  debutanteName?: string;
  debutDate?: string;
  venueName?: string;
}

const {
  guestInfo,
} = Astro.props;
---

<!-- Actual Page Content (Revealed after Splash Opening Transition) -->
<div id="main-revealed-content" class="main-revealed-wrapper hidden-main">
  
  <!-- Royal Celebration Header (ISABEL | XVIII) -->
  <header class="revealed-hero-header section-padding" id="main-top">
    <div class="container-custom text-center">
      <div class="revealed-hero-layout">
        <div class="revealed-hero-copy">
      
      <!-- Top Royal Crest Badge -->
      <div class="top-crest-badge font-serif reveal-on-scroll">
        <span class="star-accent">✦</span>
        <span class="badge-text">CHAPTER XVIII DEBUT CELEBRATION</span>
        <span class="star-accent">✦</span>
      </div>

      <!-- Main Event Title Frame (ISABEL | XVIII) -->
      <div class="main-title-frame-container reveal-on-scroll">
        <div class="title-side-line left-line"></div>
        <h1 class="main-event-title font-serif text-gold-gradient">
          ISABEL <span class="divider-star">✦</span> XVIII
        </h1>
        <div class="title-side-line right-line"></div>
      </div>

      <p class="event-subtitle font-cursive text-gold-gradient reveal-on-scroll">
        Once Upon Eighteen
      </p>

        </div>

        <div class="crystal-portrait-stage reveal-on-scroll" aria-label="Portraits of Isabel">
          <figure class="crystal-portrait crystal-portrait-one">
            <Image
              src={glassPortraitOne}
              alt="Isabel wearing a violet gown in an illuminated crystal frame"
              widths={[320, 480, 640]}
              sizes="(max-width: 820px) 58vw, 300px"
              quality={84}
              format="webp"
              loading="eager"
            />
          </figure>
          <figure class="crystal-portrait crystal-portrait-two">
            <Image
              src={glassPortraitTwo}
              alt="Isabel wearing a red formal gown in an illuminated crystal frame"
              widths={[320, 480, 640]}
              sizes="(max-width: 820px) 58vw, 300px"
              quality={84}
              format="webp"
              loading="eager"
            />
          </figure>
        </div>
      </div>

      <!-- Structured Luxury Event Details Card (Includes Venue!) -->
      <div class="event-details-card glass-card reveal-on-scroll">
        <div class="detail-badge-item">
          <span class="detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l1.15 3.2L16 7.5l-2.85 1.3L12 12l-1.15-3.2L8 7.5l2.85-1.3L12 3z" />
              <path d="M18.5 13.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8zM5.5 12l.65 1.65L7.8 14.3l-1.65.65L5.5 16.6l-.65-1.65-1.65-.65 1.65-.65L5.5 12z" />
            </svg>
          </span>
          <span class="detail-val font-serif-sub">18th Birthday Debut Celebration</span>
        </div>

        <span class="detail-divider" aria-hidden="true">
          <svg viewBox="0 0 16 16"><path d="M8 1.5 9.6 6.4 14.5 8l-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6L8 1.5Z" /></svg>
        </span>

        <div class="detail-badge-item">
          <span class="detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.5 3.5v3M14.5 3.5v3M4 8.5h12" />
              <path d="M15.5 13.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z" />
              <path d="M15.5 15.7v2.3l1.6 1" />
              <path d="M11.5 19.5H5.8A1.8 1.8 0 0 1 4 17.7V6.3a1.8 1.8 0 0 1 1.8-1.8h9.4A1.8 1.8 0 0 1 17 6.3v4.4" />
            </svg>
          </span>
          <span class="detail-val font-serif-sub">Sunday, August 30, 2026 • 5:00 PM</span>
        </div>

        <span class="detail-divider" aria-hidden="true">
          <svg viewBox="0 0 16 16"><path d="M8 1.5 9.6 6.4 14.5 8l-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6L8 1.5Z" /></svg>
        </span>

        <div class="detail-badge-item">
          <span class="detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <span class="detail-val font-serif-sub">Alton Bar and Restaurant, Kabankalan City</span>
        </div>
      </div>

    </div>
  </header>

  <!-- Story Gallery Section -->
  <StoryGallery />

  <!-- Real-Time Countdown Clock -->
  <CountdownTimer targetDate="2026-08-30T17:00:00" />

  <!-- Standalone Venue Section (Custom Dark Map) -->
  <VenueSection />

  <!-- Standalone Dress Code & Theme Section -->
  <DressCodeSection />

  <!-- Full XVIII Entourage Guest List Roster -->
  <GuestListSection currentGuestName={guestInfo.rawName} />

  <!-- Simplified RSVP Form & VIP Pass Card -->
  <RSVPModal guestName={guestInfo.rawName} role={guestInfo.role} />

  <!-- Page Footer -->
  <Footer guestName={guestInfo.rawName} />

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollBtn = document.getElementById('scroll-down-btn');
    const stickyWrap = document.getElementById('sticky-scroll-wrap');

    if (scrollBtn) {
      scrollBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('photoshoot');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Hide sticky scroll indicator near bottom of page
    if (stickyWrap) {
      let scrollFrame = 0;
      const updateStickyIndicator = () => {
        scrollFrame = 0;
        const scrollPos = window.scrollY || window.pageYOffset;
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;

        if (scrollPos > totalHeight - 300) {
          stickyWrap.classList.add('sticky-hidden');
        } else {
          stickyWrap.classList.remove('sticky-hidden');
        }
      };
      const handleScroll = () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateStickyIndicator);
      };
      const cleanupScroll = () => {
        window.removeEventListener('scroll', handleScroll);
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        scrollFrame = 0;
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('pagehide', cleanupScroll, { once: true });
      updateStickyIndicator();
    }
  });
</script>

<style>
  .main-revealed-wrapper {
    position: relative;
    z-index: 1;
    transition:
      opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 1;
    transform: translateY(0);
  }

  .main-revealed-wrapper.hidden-main {
    opacity: 0;
    pointer-events: none;
    transform: translateY(30px);
  }

  .main-revealed-wrapper.revealed-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .text-center {
    text-align: center;
  }

  .revealed-hero-header {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .revealed-hero-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -12rem;
    right: -9rem;
    width: 40rem;
    height: 40rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 113, 235, 0.18), transparent 68%);
    filter: blur(12px);
    pointer-events: none;
  }

  .revealed-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .revealed-hero-copy {
    min-width: 0;
  }

  .crystal-portrait-stage {
    position: relative;
    width: 100%;
    min-height: 500px;
    isolation: isolate;
  }

  .crystal-portrait {
    position: absolute;
    width: min(64%, 300px);
    aspect-ratio: 2 / 3;
    margin: 0;
    background: transparent;
    will-change: transform;
  }

  .crystal-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .crystal-portrait-one {
    z-index: 1;
    top: 36px;
    left: 0;
    transform: rotate(-3deg);
    animation: crystal-float-one 7.5s ease-in-out infinite;
  }

  .crystal-portrait-two {
    z-index: 2;
    top: 0;
    right: 0;
    transform: rotate(3deg);
    animation: crystal-float-two 8.5s ease-in-out -2.4s infinite;
  }

  @keyframes crystal-float-one {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(-3deg);
    }
    50% {
      transform: translate3d(3px, -9px, 0) rotate(-2.35deg);
    }
  }

  @keyframes crystal-float-two {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(3deg);
    }
    50% {
      transform: translate3d(-3px, -11px, 0) rotate(2.3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crystal-portrait {
      animation: none;
      will-change: auto;
    }
  }

  /* Top Royal Crest Badge */
  .top-crest-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.25rem;
    border-radius: 20px;
    background: rgba(11, 19, 43, 0.75);
    border: 1px solid var(--gold-500);
    box-shadow:
      0 4px 15px rgba(0, 0, 0, 0.6),
      0 0 15px rgba(212, 175, 55, 0.2);
    margin-bottom: 1.5rem;
  }

  .star-accent {
    color: var(--gold-400);
    font-size: 0.8rem;
  }

  .badge-text {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--gold-300);
    font-weight: 700;
  }

  /* Main Title Frame Container */
  .main-title-frame-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .title-side-line {
    flex: 1;
    max-width: 120px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--gold-400),
      transparent
    );
  }

  @media (max-width: 600px) {
    .title-side-line {
      display: none;
    }
  }

  .main-event-title {
    font-size: clamp(2rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.1;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    white-space: nowrap;
  }

  .divider-star {
    font-size: 0.6em;
    color: var(--gold-400);
    vertical-align: middle;
  }

  .event-subtitle {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
  }

  /* Structured Luxury Event Details Card */
  .event-details-card {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
    padding: 1.4rem 1rem;
    max-width: 1000px;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
    border: 1px solid rgba(212, 175, 55, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(212, 175, 55, 0.2);
    border-radius: 20px;
  }

  .detail-badge-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    padding: 0.15rem 1.15rem;
  }

  .detail-badge-item:not(:last-child) {
    border-right: 1px solid rgba(212, 175, 55, 0.22);
  }

  .detail-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    color: var(--gold-300);
    background: linear-gradient(145deg, rgba(255, 242, 176, 0.12), rgba(10, 18, 42, 0.38));
    border: 1px solid rgba(232, 199, 91, 0.5);
    border-radius: 50%;
    box-shadow: inset 0 0 12px rgba(255, 231, 145, 0.07), 0 0 14px rgba(212, 175, 55, 0.12);
  }

  .detail-icon svg {
    width: 30px;
    height: 30px;
  }

  .detail-val {
    min-width: 0;
    font-size: clamp(0.88rem, 1.4vw, 1rem);
    line-height: 1.35;
    color: var(--starlight);
    text-align: center;
  }

  .detail-divider {
    display: none;
  }

  .detail-divider svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  @media (max-width: 900px) {
    .revealed-hero-header {
      padding-top: 3.25rem;
    }

    .revealed-hero-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .crystal-portrait-stage {
      width: min(100%, 560px);
      min-height: clamp(350px, 92vw, 500px);
      margin: 0 auto;
    }

    .crystal-portrait {
      width: min(58%, 280px);
    }

    .crystal-portrait-one {
      top: 30px;
      left: 4%;
    }

    .crystal-portrait-two {
      right: 4%;
    }
  }

  @media (max-width: 767px) {
    .event-details-card {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 1.1rem 0.35rem;
    }

    .detail-badge-item {
      width: 100%;
      gap: 0.6rem;
      padding: 0.15rem 0.45rem;
    }

    .detail-icon {
      width: clamp(48px, 13vw, 56px);
      height: clamp(48px, 13vw, 56px);
    }

    .detail-icon svg {
      width: clamp(25px, 7vw, 29px);
      height: clamp(25px, 7vw, 29px);
    }

    .detail-val {
      white-space: normal;
      font-size: clamp(0.68rem, 2.55vw, 0.86rem);
      line-height: 1.35;
      text-align: center;
    }
  }

  @media (max-width: 520px) {
    .revealed-hero-header {
      padding-top: 2.75rem;
      padding-bottom: 3rem;
    }

    .crystal-portrait-stage {
      min-height: clamp(330px, 105vw, 430px);
      margin-top: 0.5rem;
    }

    .crystal-portrait {
      width: 61%;
    }

    .crystal-portrait-one {
      top: 24px;
      left: 0;
    }

    .crystal-portrait-two {
      right: 0;
    }

    .event-details-card {
      margin-top: 3.5rem;
    }
  }

  /* Sticky Flashing Animated Scroll Indicator */
  .hero-scroll-indicator-wrap {
    position: fixed;
    bottom: 85px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99;
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: auto;
  }

  .hero-scroll-indicator-wrap.sticky-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 20px);
  }

  .scroll-indicator-link {
    background: rgba(6, 11, 25, 0.88) !important;
    backdrop-filter: blur(10px);
    border: 1px solid var(--gold-500) !important;
    border-radius: 24px;
    padding: 0.4rem 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none !important;
    color: var(--gold-300) !important;
    cursor: pointer;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.9), 0 0 15px rgba(212, 175, 55, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .scroll-indicator-link:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.95), 0 0 25px rgba(212, 175, 55, 0.5);
    color: var(--gold-200) !important;
  }

  .scroll-label-text {
    font-size: 0.68rem;
    letter-spacing: 0.25em;
    font-weight: 700;
    color: var(--gold-300) !important;
    margin-bottom: 0.2rem;
    text-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
    white-space: nowrap;
  }

  .animated-chevron-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: -4px;
  }

  .chevron-svg {
    color: var(--gold-300);
    filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.8));
  }

  .chevron-1 {
    animation: chevronFlashPulse 1.8s ease-in-out infinite;
  }

  .chevron-2 {
    margin-top: -6px;
    animation: chevronFlashPulse 1.8s ease-in-out infinite 0.35s;
    opacity: 0.6;
  }

  @keyframes chevronFlashPulse {
    0% {
      opacity: 0.2;
      transform: translateY(-4px) scale(0.9);
    }
    50% {
      opacity: 1;
      transform: translateY(3px) scale(1.1);
      filter: drop-shadow(0 0 14px rgba(255, 246, 213, 0.95)) drop-shadow(0 0 6px rgba(212, 175, 55, 1));
    }
    100% {
      opacity: 0.2;
      transform: translateY(8px) scale(0.9);
    }
  }
</style>
