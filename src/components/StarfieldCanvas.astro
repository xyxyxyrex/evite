---
---

<div class="starfield-container">
  <canvas id="starfield-canvas"></canvas>
  <div class="gradient-overlay"></div>
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>
  <div class="ambient-orb orb-3"></div>
</div>

<script>
  class Starfield {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    stars: Array<{
      x: number;
      y: number;
      size: number;
      alpha: number;
      alphaSpeed: number;
      color: string;
      vy: number;
      vx: number;
    }> = [];
    width: number = 0;
    height: number = 0;
    animationFrameId: number = 0;
    isRunning: boolean = false;
    lastFrameTime: number = 0;

    constructor() {
      this.canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d', { alpha: true })!;
      this.init();
    }

    init() {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.canvas.width = this.width;
      this.canvas.height = this.height;

      // Smart mobile resize listener: ignore height-only resizes from mobile address bar collapse
      let lastWidth = this.width;
      window.addEventListener('resize', () => {
        const newWidth = window.innerWidth;
        if (Math.abs(newWidth - lastWidth) > 10) {
          lastWidth = newWidth;
          this.resize();
        }
      });

      // Pause animation loop when tab is hidden or backgrounded to conserve RAM & battery
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          this.stop();
        } else {
          this.start();
        }
      });

      this.createStars();
      this.start();
    }

    resize() {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.canvas.width = this.width;
      this.canvas.height = this.height;
      this.createStars();
    }

    createStars() {
      // Mobile optimization: cap max star count to keep memory footprint under 3MB
      const isMobile = this.width < 768;
      const rawCount = Math.floor((this.width * this.height) / 8000);
      const starCount = isMobile ? Math.min(30, rawCount) : Math.min(80, rawCount);
      
      this.stars = [];
      const colors = ['#FFFFFF', '#FDF3CB', '#EECE5A', '#94A3B8', '#D4AF37'];

      for (let i = 0; i < starCount; i++) {
        this.stars.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          size: Math.random() * 1.6 + 0.5,
          alpha: Math.random(),
          alphaSpeed: (Math.random() * 0.01 + 0.003) * (Math.random() > 0.5 ? 1 : -1),
          color: colors[Math.floor(Math.random() * colors.length)],
          vy: -(Math.random() * 0.2 + 0.06),
          vx: (Math.random() - 0.5) * 0.06
        });
      }
    }

    start() {
      if (!this.isRunning) {
        this.isRunning = true;
        this.lastFrameTime = performance.now();
        this.animate();
      }
    }

    stop() {
      this.isRunning = false;
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
        this.animationFrameId = 0;
      }
    }

    animate() {
      if (!this.isRunning) return;

      const now = performance.now();
      const isMobile = this.width < 768;
      const frameThreshold = isMobile ? 33 : 16; // 30fps cap on mobile to save 50% CPU/GPU RAM

      if (now - this.lastFrameTime >= frameThreshold) {
        this.lastFrameTime = now;
        this.ctx.clearRect(0, 0, this.width, this.height);

        for (let i = 0; i < this.stars.length; i++) {
          const star = this.stars[i];
          
          // Twinkle
          star.alpha += star.alphaSpeed;
          if (star.alpha <= 0.15 || star.alpha >= 0.9) {
            star.alphaSpeed = -star.alphaSpeed;
          }

          // Float upwards softly
          star.y += star.vy;
          star.x += star.vx;

          if (star.y < 0) {
            star.y = this.height;
            star.x = Math.random() * this.width;
          }

          const currentAlpha = Math.max(0.1, Math.min(0.9, star.alpha));
          this.ctx.fillStyle = star.color;

          // Draw star core without expensive shadowBlur
          this.ctx.globalAlpha = currentAlpha;
          this.ctx.beginPath();
          this.ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
          this.ctx.fill();
        }
      }

      this.animationFrameId = requestAnimationFrame(() => this.animate());
    }
  }

  function onReady(fn: () => void) {
    if (document.readyState !== 'loading') {
      fn();
    } else {
      document.addEventListener('DOMContentLoaded', fn);
    }
  }

  onReady(() => {
    new Starfield();
  });
</script>

<style>
  .starfield-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  #starfield-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(11, 19, 43, 0.4) 0%, rgba(8, 14, 30, 0.85) 100%);
    pointer-events: none;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    opacity: 0.12;
    pointer-events: none;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.3) 0%, transparent 70%);
    top: 10%;
    left: 15%;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(26, 38, 71, 0.5) 0%, transparent 70%);
    bottom: 20%;
    right: 10%;
  }

  .orb-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(238, 206, 90, 0.25) 0%, transparent 70%);
    top: 55%;
    left: 45%;
  }
</style>
