---
---

<div class="starfield-container">
  <canvas id="starfield-canvas"></canvas>
  <div class="gradient-overlay"></div>
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>
  <div class="ambient-orb orb-3"></div>
</div>

<script>
  import { getRenderingBudget } from "../utils/performance";

  interface Star {
    x: number;
    y: number;
    size: number;
    alpha: number;
    alphaSpeed: number;
    color: string;
    vy: number;
    vx: number;
  }

  class Starfield {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    stars: Star[] = [];
    width = 0;
    height = 0;
    animationFrameId = 0;
    isRunning = false;
    isDestroyed = false;
    lastFrameTime = 0;
    lastWidth = 0;
    motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    budget = getRenderingBudget(window.innerWidth, this.motionQuery.matches);

    constructor(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
      this.canvas = canvas;
      this.ctx = ctx;
      this.handleResize = this.handleResize.bind(this);
      this.handleVisibilityChange = this.handleVisibilityChange.bind(this);
      this.handleMotionChange = this.handleMotionChange.bind(this);
      this.handlePageHide = this.handlePageHide.bind(this);
      this.handlePageShow = this.handlePageShow.bind(this);
      this.init();
    }

    init() {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.lastWidth = this.width;
      this.sizeCanvas();
      this.createStars();

      window.addEventListener("resize", this.handleResize, { passive: true });
      document.addEventListener("visibilitychange", this.handleVisibilityChange);
      this.motionQuery.addEventListener("change", this.handleMotionChange);
      window.addEventListener("pagehide", this.handlePageHide);
      window.addEventListener("pageshow", this.handlePageShow);
      this.start();
    }

    sizeCanvas() {
      this.canvas.width = Math.max(1, this.width);
      this.canvas.height = Math.max(1, this.height);
    }

    handleResize() {
      const newWidth = window.innerWidth;
      if (Math.abs(newWidth - this.lastWidth) <= 10) return;
      this.lastWidth = newWidth;
      this.width = newWidth;
      this.height = window.innerHeight;
      this.budget = getRenderingBudget(this.width, this.motionQuery.matches);
      this.sizeCanvas();
      this.createStars();
      if (this.budget.starfieldFps === 0) this.stop();
      else this.start();
    }

    handleVisibilityChange() {
      if (document.hidden) this.stop();
      else this.start();
    }

    handleMotionChange() {
      this.budget = getRenderingBudget(window.innerWidth, this.motionQuery.matches);
      this.createStars();
      if (this.budget.starfieldFps === 0) this.stop();
      else this.start();
    }

    handlePageHide(event: PageTransitionEvent) {
      if (event.persisted) this.stop();
      else this.destroy();
    }

    handlePageShow() {
      if (!this.isDestroyed && !document.hidden) this.start();
    }

    createStars() {
      const rawCount = Math.floor((this.width * this.height) / 8000);
      const starCount = Math.min(this.budget.starCount, rawCount);
      const colors = ["#FFFFFF", "#FDF3CB", "#EECE5A", "#94A3B8", "#D4AF37"];
      this.stars = [];

      for (let i = 0; i < starCount; i++) {
        this.stars.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          size: Math.random() * 1.6 + 0.5,
          alpha: Math.random(),
          alphaSpeed: (Math.random() * 0.01 + 0.003) * (Math.random() > 0.5 ? 1 : -1),
          color: colors[Math.floor(Math.random() * colors.length)],
          vy: -(Math.random() * 0.2 + 0.06),
          vx: (Math.random() - 0.5) * 0.06,
        });
      }

      if (starCount === 0) this.ctx.clearRect(0, 0, this.width, this.height);
    }

    start() {
      if (this.isDestroyed || this.isRunning || this.budget.starfieldFps === 0) return;
      this.isRunning = true;
      this.lastFrameTime = performance.now();
      this.animationFrameId = requestAnimationFrame((now) => this.animate(now));
    }

    stop() {
      this.isRunning = false;
      if (this.animationFrameId) cancelAnimationFrame(this.animationFrameId);
      this.animationFrameId = 0;
    }

    animate(now: number) {
      if (!this.isRunning || this.isDestroyed) return;
      const frameThreshold = 1000 / this.budget.starfieldFps;

      if (now - this.lastFrameTime >= frameThreshold) {
        this.lastFrameTime = now;
        this.ctx.clearRect(0, 0, this.width, this.height);

        for (const star of this.stars) {
          star.alpha += star.alphaSpeed;
          if (star.alpha <= 0.15 || star.alpha >= 0.9) star.alphaSpeed = -star.alphaSpeed;
          star.y += star.vy;
          star.x += star.vx;
          if (star.y < 0) {
            star.y = this.height;
            star.x = Math.random() * this.width;
          }

          this.ctx.globalAlpha = Math.max(0.1, Math.min(0.9, star.alpha));
          this.ctx.fillStyle = star.color;
          this.ctx.beginPath();
          this.ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
          this.ctx.fill();
        }
      }

      this.animationFrameId = requestAnimationFrame((nextNow) => this.animate(nextNow));
    }

    destroy() {
      if (this.isDestroyed) return;
      this.isDestroyed = true;
      this.stop();
      window.removeEventListener("resize", this.handleResize);
      document.removeEventListener("visibilitychange", this.handleVisibilityChange);
      this.motionQuery.removeEventListener("change", this.handleMotionChange);
      window.removeEventListener("pagehide", this.handlePageHide);
      window.removeEventListener("pageshow", this.handlePageShow);
      this.stars = [];
      this.canvas.width = 1;
      this.canvas.height = 1;
    }
  }

  function initializeStarfield() {
    const canvas = document.getElementById("starfield-canvas") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d", { alpha: true });
    if (canvas && ctx) new Starfield(canvas, ctx);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeStarfield, { once: true });
  } else {
    initializeStarfield();
  }
</script>

<style>
  .starfield-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  #starfield-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(11, 19, 43, 0.4) 0%, rgba(8, 14, 30, 0.85) 100%);
    pointer-events: none;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    opacity: 0.12;
    pointer-events: none;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.3) 0%, transparent 70%);
    top: 10%;
    left: 15%;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(26, 38, 71, 0.5) 0%, transparent 70%);
    bottom: 20%;
    right: 10%;
  }

  .orb-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(238, 206, 90, 0.25) 0%, transparent 70%);
    top: 55%;
    left: 45%;
  }
</style>
