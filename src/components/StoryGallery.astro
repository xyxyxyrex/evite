const PL3_hd = await getImage({ src: PL3, width: 1400, quality: 84, format: 'webp' });
const PL4_hd = await getImage({ src: PL4, width: 1400, quality: 84, format: 'webp' });
const PL5_hd = await getImage({ src: PL5, width: 1400, quality: 84, format: 'webp' });
const PL6_hd = await getImage({ src: PL6, width: 1400, quality: 84, format: 'webp' });
const PP1_hd = await getImage({ src: PP1, width: 1400, quality: 84, format: 'webp' });

const RL1_hd = await getImage({ src: RL1, width: 1400, quality: 84, format: 'webp' });
const RL3_hd = await getImage({ src: RL3, width: 1400, quality: 84, format: 'webp' });

const RP1_hd = await getImage({ src: RP1, width: 1400, quality: 84, format: 'webp' });
const RP2_hd = await getImage({ src: RP2, width: 1400, quality: 84, format: 'webp' });
const RP3_hd = await getImage({ src: RP3, width: 1400, quality: 84, format: 'webp' });
const RP4_hd = await getImage({ src: RP4, width: 1400, quality: 84, format: 'webp' });
const RP6_hd = await getImage({ src: RP6, width: 1400, quality: 84, format: 'webp' });
const RP8_hd = await getImage({ src: RP8, width: 1400, quality: 84, format: 'webp' });
