import RP3 from "../assets/RP3.jpg";
import RP4 from "../assets/RP4.jpg";
import RP6 from "../assets/RP6.jpg";
import RP8 from "../assets/RP8.jpg";

// Generate High-Definition WebP Lightbox Images (~120KB)
const PL1_hd = await getImage({ src: PL1, width: 1400, quality: 84, format: 'webp' });
