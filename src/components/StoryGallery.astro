<script>
  // Intersection Observer & Lightbox Engine
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Scroll Reveal Observer
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.12,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const revealElements = document.querySelectorAll(".reveal-on-scroll");
    revealElements.forEach((el) => observer.observe(el));

    // 2. Lightbox Engine with Mobile Drag Safety & Dynamic SRC Resolution
    const triggers = Array.from(document.querySelectorAll('.gallery-lightbox-trigger'));
    const modalEl = document.getElementById('gallery-lightbox') as HTMLElement | null;
    const backdrop = document.getElementById('lightbox-backdrop');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const mainImg = document.getElementById('lightbox-main-img') as HTMLImageElement | null;
    const titleEl = document.getElementById('lightbox-title-text');
    const subEl = document.getElementById('lightbox-sub-text');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');

    if (!modalEl || !mainImg || triggers.length === 0) return;
    const modal = modalEl; // Non-null type assertion for closed-over callbacks
    const lightboxImage = mainImg;
    let imageReleaseTimeout: number | null = null;

    function releaseLightboxImage() {
      if (imageReleaseTimeout !== null) clearTimeout(imageReleaseTimeout);
      imageReleaseTimeout = null;
      lightboxImage.onload = null;
      lightboxImage.removeAttribute('src');
      lightboxImage.removeAttribute('srcset');
    }

    function getTriggerData(el: Element) {
      const customSrc = el.getAttribute('data-lightbox-src');
      const img = el.querySelector('img');
      const title = el.querySelector('.caption-title, .banner-title, .feature-title');
      const sub = el.querySelector('.caption-sub, .banner-desc, .feature-quote');

      let src = customSrc || '';
      if (!src && img) {
        src = img.getAttribute('src') || img.currentSrc || img.src || '';
        if ((!src || src.includes('data:image')) && img.srcset) {
          const parts = img.srcset.split(',');
          const lastPart = parts[parts.length - 1].trim().split(' ')[0];
          if (lastPart) src = lastPart;
        }
      }

      return {
        src,
        title: title ? title.textContent?.trim() || '' : 'Isabel | XVIII',
        sub: sub ? sub.textContent?.trim() || '' : 'Chapter XVIII Debut Celebration'
      };
    }

    let currentIndex = 0;

    function openLightbox(index: number) {
      if (index < 0 || index >= triggers.length) return;
      if (imageReleaseTimeout !== null) clearTimeout(imageReleaseTimeout);
      imageReleaseTimeout = null;
      currentIndex = index;
      const data = getTriggerData(triggers[currentIndex]);

      // Move modal to body to break out of any parent CSS transform containers
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }

      if (data.src) {
        lightboxImage.onload = null;
        lightboxImage.style.opacity = '0';
        lightboxImage.src = data.src;
        lightboxImage.onload = () => {
          lightboxImage.style.opacity = '1';
        };
        // Fallback opacity if already cached
        if (lightboxImage.complete) {
          lightboxImage.style.opacity = '1';
        }
      }

      if (titleEl) {
        const formattedTitle = data.title.replace(/XVIII/g, '<span class="font-serif regular-xviii">XVIII</span>');
        titleEl.innerHTML = formattedTitle;
      }
      if (subEl) subEl.textContent = data.sub;

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      imageReleaseTimeout = window.setTimeout(() => {
        if (!modal.classList.contains('is-open')) releaseLightboxImage();
      }, 400);
    }

    function showNext() {
      openLightbox((currentIndex + 1) % triggers.length);
    }

    function showPrev() {
      openLightbox((currentIndex - 1 + triggers.length) % triggers.length);
    }

    // Attach Mobile Drag Safe Event Handlers
    triggers.forEach((trigger, index) => {
      let touchStartX = 0;
      let touchStartY = 0;
      let isTouchDrag = false;

      trigger.addEventListener('touchstart', (e) => {
        const touch = (e as TouchEvent).touches[0];
        if (touch) {
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
        }
        isTouchDrag = false;
      }, { passive: true });

      trigger.addEventListener('touchmove', (e) => {
        const touch = (e as TouchEvent).touches[0];
        if (touch) {
          const moveX = Math.abs(touch.clientX - touchStartX);
          const moveY = Math.abs(touch.clientY - touchStartY);
          if (moveX > 10 || moveY > 10) {
            isTouchDrag = true;
          }
        }
      }, { passive: true });

      trigger.addEventListener('click', () => {
        if (!isTouchDrag) {
          openLightbox(index);
        }
      });
    });

    // Close & Nav Event Listeners
    closeBtn?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });

    window.addEventListener('pagehide', (event) => {
      if (!event.persisted) observer.disconnect();
      releaseLightboxImage();
    }, { once: true });
  });
</script>

