---
---

<section class="section-padding story-section" id="story">
  <div class="container-custom">
    
    <div class="section-header text-center">
      <span class="section-badge font-serif">Our Journey</span>
      <h2 class="section-title text-gold-gradient font-serif">An Enchanted Love Story</h2>
      <p class="section-desc font-serif-sub">Every love story is beautiful, but ours is our favorite.</p>
    </div>

    <div class="story-grid">
      
      <!-- Couple Hero Card -->
      <div class="glass-card story-hero-card">
        <div class="story-img-container">
          <img src="/images/couple.png" alt="Eleanor & Marcus" class="story-img" />
          <div class="story-img-overlay"></div>
        </div>
        <div class="story-hero-content">
          <h3 class="story-couple-title font-cursive text-gold-gradient">Eleanor & Marcus</h3>
          <p class="story-quote font-serif-sub">"From the first glance beneath the midnight stars to a lifetime of adventures together."</p>
        </div>
      </div>

      <!-- Timeline Items -->
      <div class="timeline-container">
        
        <!-- Timeline 1 -->
        <div class="timeline-item">
          <div class="timeline-dot">✦</div>
          <div class="glass-card timeline-card">
            <span class="timeline-date font-serif">Autumn 2021</span>
            <h4 class="timeline-title font-serif">The First Chapter</h4>
            <p class="timeline-text">A chance encounter at the botanical conservatory cafe turned into hours of endless conversation under twilight skies.</p>
          </div>
        </div>

        <!-- Timeline 2 -->
        <div class="timeline-item">
          <div class="timeline-dot">✦</div>
          <div class="glass-card timeline-card">
            <span class="timeline-date font-serif">Winter 2024</span>
            <h4 class="timeline-title font-serif">The Proposal</h4>
            <p class="timeline-text">Beneath a canopy of glowing lantern light along the French Riviera, Marcus asked the question that changed forever into ALWAYS.</p>
          </div>
        </div>

        <!-- Timeline 3 -->
        <div class="timeline-item">
          <div class="timeline-dot">✦</div>
          <div class="glass-card timeline-card">
            <span class="timeline-date font-serif">November 14, 2026</span>
            <h4 class="timeline-title font-serif">The Wedding Day</h4>
            <p class="timeline-text">Joining hands before family and closest friends to embark on our greatest adventure yet.</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .story-section {
    position: relative;
    z-index: 1;
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .section-badge {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold-300);
    margin-bottom: 0.5rem;
    display: block;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-desc {
    font-size: 1.1rem;
    color: var(--starlight-dim);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .story-hero-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .story-img-container {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 380px;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .story-hero-card:hover .story-img {
    transform: scale(1.04);
  }

  .story-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 19, 43, 0.95), transparent 60%);
  }

  .story-hero-content {
    margin-top: -3.5rem;
    position: relative;
    z-index: 2;
    padding: 1rem;
    text-align: center;
  }

  .story-couple-title {
    font-size: 3.25rem;
    margin-bottom: 0.5rem;
  }

  .story-quote {
    font-size: 1.1rem;
    color: var(--starlight);
    font-style: italic;
  }

  .timeline-container {
    position: relative;
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline-container::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 15px;
    bottom: 15px;
    width: 2px;
    background: linear-gradient(to bottom, var(--gold-300), var(--navy-700), var(--gold-500));
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 1.25rem;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--navy-850);
    border: 1.5px solid var(--gold-400);
    color: var(--gold-300);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
    z-index: 2;
  }

  .timeline-card {
    padding: 1.5rem;
  }

  .timeline-date {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 0.25rem;
    display: block;
  }

  .timeline-title {
    font-size: 1.25rem;
    color: var(--starlight);
    margin-bottom: 0.5rem;
  }

  .timeline-text {
    font-size: 0.95rem;
    color: var(--starlight-dim);
    line-height: 1.5;
  }
</style>
